---
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';

import imgDesktop from '../assets/divisorias-de-vidros-com-persianas-1920px.webp';
import imgMobile from '../assets/divisorias-de-vidros-com-persianas-768x1080.webp';

import globalCss from '../styles/global.css?raw';

const { title = "Site", description = "" } = Astro.props;

const lcpDesktop = await getImage({
  src: imgDesktop,
  format: 'webp',
  quality: 45,
  width: 1920
});

const lcpMobile = await getImage({
  src: imgMobile,
  format: 'webp',
  quality: 45,
  width: 768
});
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="theme-color"
    content="#050505"
  />

  <!-- PRELOAD LCP -->
  <link
    rel="preload"
    as="image"
    href={lcpDesktop.src}
    fetchpriority="high"
    media="(min-width: 768px)"
  />

  <link
    rel="preload"
    as="image"
    href={lcpMobile.src}
    fetchpriority="high"
    media="(max-width: 767px)"
  />

  <!-- CSS GLOBAL INLINE -->
  <style is:inline set:html={globalCss}></style>

</head>

<body>

  <slot />

  <Footer />

</body>

</html>