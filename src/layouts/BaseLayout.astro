---
const { title = "Site", description = "" } = Astro.props;

import Footer from '../components/Footer.astro';

import '../styles/global.css';
import '../styles/fonts.css';
---

<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <!-- PRELOAD DAS FONTES -->

  <link
    rel="preload"
    href="/fonts/cormorant/Cormorant-Regular.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <link
    rel="preload"
    href="/fonts/inter/inter-Light.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <link
    rel="preload"
    href="/fonts/inter/inter-Bold.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

</head>

<body>

  <slot />

  <Footer />

</body>

</html>