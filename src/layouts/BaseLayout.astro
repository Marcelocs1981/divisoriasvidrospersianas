---
const { title = "Site", description = "" } = Astro.props;
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preload" href="/fonts/cormorant/Cormorant-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="preload" href="/fonts/inter/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">

  <style is:global>
    @import "../styles/global.css";
  </style>

  <link rel="preconnect" href="https://divisoriasvidrospersianas.vercel.app" crossorigin>
</head>

<body>
  
  <slot />
  <Footer />

</body>
</html>