---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  seo?: {
    title?: string;
    description?: string;
    canonical?: string;
  };
  lcpDesktopSrc?: string;
  lcpMobileSrc?: string;
}

const { seo, lcpDesktopSrc = "", lcpMobileSrc = "" } = Astro.props;
const title = seo?.title ?? "Site";
const description = seo?.description ?? "";
const canonical = seo?.canonical ?? Astro.url.href;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#050505" />
  <link rel="canonical" href={canonical} />

  <!-- PRELOAD LOGO RODAPÉ — aparece em todas as páginas -->
  <link
    rel="preload"
    href="/divisorias-vidros-persianas-logo.png"
    as="image"
    fetchpriority="low"
  />

  <!-- SLOT PARA PRELOADS ESPECÍFICOS DE CADA PÁGINA -->
  <slot name="head" />

  {lcpDesktopSrc && (
    <link
      rel="preload"
      as="image"
      href={lcpDesktopSrc}
      fetchpriority="high"
      media="(min-width: 768px)"
    />
  )}
  {lcpMobileSrc && (
    <link
      rel="preload"
      as="image"
      href={lcpMobileSrc}
      fetchpriority="high"
      media="(max-width: 767px)"
    />
  )}
</head>
<body>
  <slot />
  <Footer />
</body>
</html>