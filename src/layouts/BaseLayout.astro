---
// src/layouts/BaseLayout.astro
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import BackToTop from "../components/BackToTop.astro";
import MainMenu from "../components/MainMenu.astro";
import { getGlobalSchema } from "../schemas/GlobalSchema";

interface Props {
  title?: string;
  seo?: {
    title?: string;
    description?: string;
    canonical?: string;
    image?: string;
    imageAlt?: string;
    datePublished?: string;
    dateModified?: string;
    breadcrumbs?: { name: string; url: string }[];
    type?: string;
    ogType?: string;
  };
  lcpDesktopSrcset?: string;
  lcpMobileSrc?: string;
  schemaData?: Record<string, any>[];
}

const {
  title,
  seo,
  lcpDesktopSrcset = "",
  lcpMobileSrc = "",
  schemaData = [],
} = Astro.props;

// Definições de Fallback
const finalTitle =
  title ||
  seo?.title ||
  "Desenhos para Colorir e Imprimir Grátis - Imprimi Printer";
const description =
  seo?.description ??
  "Milhares de desenhos para colorir, pintar e imprimir grátis. Atividades educativas, personagens, animais e muito mais para entreter e educar as crianças.";
const canonical = seo?.canonical ?? Astro.url.href;
const image =
  seo?.image ?? "https://imprimiprinter.com.br/assets/og-image-padrao.jpg";
const imageAlt =
  seo?.imageAlt ?? "Desenhos para colorir e imprimir - Imprimi Printer";

// SEO Payload para Schema
const seoPayload = {
  title: finalTitle,
  description,
  datePublished: seo?.datePublished ?? "2026-05-18T14:24:08Z",
  dateModified: seo?.dateModified ?? new Date().toISOString(),
  image,
};

// Geração de Schema
const currentUrl = new URL(
  Astro.url.pathname,
  Astro.site || "https://imprimiprinter.com.br",
).href;
const globalSchemaResult = getGlobalSchema(
  currentUrl,
  seoPayload,
  seo?.breadcrumbs,
);

if (Array.isArray(schemaData) && schemaData.length > 0) {
  globalSchemaResult["@graph"].push(...schemaData);
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={seo?.type || seo?.ogType || "website"} />
    <meta property="og:site_name" content="imprimiprinter" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(globalSchemaResult)}
    />

    {
      seo?.datePublished && (
        <meta property="article:published_time" content={seo.datePublished} />
      )
    }
    <meta property="article:modified_time" content={seoPayload.dateModified} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2.0" />
    <link rel="manifest" href="/site.webmanifest?v=2.0" />
    <link rel="preload" href="/logo.webp" as="image" fetchpriority="high" />

    <slot name="head" />

    <style is:global>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
      }
      main {
        flex: 1;
        padding-top: 90px;
      }
      @media (max-width: 767px) {
        main {
          padding-top: 70px;
        }
      }
    </style>
  </head>
  <body>
    <MainMenu />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
