---
---

<section
  id="cadastro-fornecedor"
  class="section-padrao section-cadastro-fornecedor"
  aria-labelledby="cadastro-fornecedor-heading"
>
  <div class="container content-grid-cadastro-fornecedor">
    <aside class="cadastro-fornecedor-info">
      <header>
        <span class="tag">Cadastro de fornecedor</span>
        <h2 id="cadastro-fornecedor-heading">
          Envie seus dados para avaliarmos uma parceria.
        </h2>
      </header>

      <p class="cadastro-fornecedor-description">
        Preencha o formulario com as principais informacoes da sua empresa,
        produtos ou servicos. Nossa equipe analisara o cadastro e entrara em
        contato quando houver aderencia com as necessidades do projeto.
      </p>
    </aside>

    <div class="form-card">
      <form
        class="cadastro-fornecedor-form"
        id="cadastro-fornecedor-form"
        method="POST"
        autocomplete="on"
      >
        <input type="hidden" name="titulo_pagina" value="Cadastro de Fornecedor" />
        <input type="hidden" name="origem_produto" value="Fornecedor" />

        <label for="nome">
          <span>Responsavel*</span>
          <input type="text" id="nome" name="nome" autocomplete="name" required />
        </label>

        <label for="empresa">
          <span>Empresa*</span>
          <input
            type="text"
            id="empresa"
            name="empresa"
            autocomplete="organization"
            required
          />
        </label>

        <label for="email">
          <span>E-mail*</span>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            inputmode="email"
            required
          />
        </label>

        <label for="telefone">
          <span>Telefone*</span>
          <input
            type="tel"
            id="telefone"
            name="telefone"
            autocomplete="tel"
            inputmode="tel"
            required
          />
        </label>

        <label for="mensagem" class="label-textarea">
          <span>Produtos ou servicos</span>
          <textarea
            id="mensagem"
            name="mensagem"
            rows="5"
            placeholder="Descreva o que sua empresa fornece, regioes atendidas e diferenciais."
          ></textarea>
        </label>

        <button type="submit" aria-label="Enviar cadastro de fornecedor">
          ENVIAR CADASTRO
        </button>

        <output
          id="cadastro-fornecedor-status"
          class="status-message"
          aria-live="polite"
        ></output>

        <small class="privacy-notice">
          Ao enviar, voce concorda com o processamento dos dados para contato
          comercial.
        </small>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "cadastro-fornecedor-form",
  ) as HTMLFormElement;
  const statusMessage = document.getElementById("cadastro-fornecedor-status");

  if (form && statusMessage) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = form.querySelector("button");
      if (!button) return;

      const defaultButtonText = button.textContent || "ENVIAR CADASTRO";
      form.setAttribute("aria-busy", "true");
      button.disabled = true;
      button.textContent = "ENVIANDO...";
      statusMessage.textContent = "";
      statusMessage.classList.remove("success", "error");

      try {
        const formData = new FormData(form);
        const response = await fetch("/send.php", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          statusMessage.textContent = "Cadastro enviado com sucesso.";
          statusMessage.classList.add("success");
          form.reset();
        } else {
          statusMessage.textContent = "Erro ao enviar cadastro.";
          statusMessage.classList.add("error");
        }
      } catch {
        statusMessage.textContent = "Erro de conexao ao enviar cadastro.";
        statusMessage.classList.add("error");
      } finally {
        form.setAttribute("aria-busy", "false");
        button.disabled = false;
        button.textContent = defaultButtonText;
      }
    });
  }
</script>

<style>
  .section-cadastro-fornecedor {
    position: relative;
  }

  .section-cadastro-fornecedor::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 70% 20%,
      rgba(124, 93, 0, 0.25),
      transparent 50%
    );
    pointer-events: none;
  }

  .content-grid-cadastro-fornecedor {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 60px;
    align-items: center;
  }

  .cadastro-fornecedor-info h2 {
    margin-bottom: 28px;
  }

  .cadastro-fornecedor-description {
    margin-bottom: 22px;
    line-height: 1.6;
  }

  .form-card {
    background: rgba(20, 20, 20, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 30px;
    backdrop-filter: blur(8px);
  }

  .cadastro-fornecedor-form {
    display: grid;
    gap: 18px;
  }

  .cadastro-fornecedor-form label {
    display: grid;
    grid-template-columns: 160px 1fr;
    align-items: center;
    gap: 14px;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .cadastro-fornecedor-form .label-textarea {
    align-items: start;
  }

  .cadastro-fornecedor-form input,
  .cadastro-fornecedor-form textarea {
    width: 100%;
    background: #050505;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: #fff;
    padding: 14px 16px;
    font-size: 0.95rem;
    outline: none;
    box-sizing: border-box;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cadastro-fornecedor-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .cadastro-fornecedor-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .cadastro-fornecedor-form input:focus,
  .cadastro-fornecedor-form textarea:focus {
    border-color: rgba(150, 112, 0, 0.7);
    box-shadow:
      0 0 0 1px rgba(150, 112, 0, 0.25),
      0 0 18px rgba(150, 112, 0, 0.08);
  }

  .cadastro-fornecedor-form button {
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: 4px;
    background: linear-gradient(180deg, #c89d37, #967000);
    color: #000;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cadastro-fornecedor-form button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(150, 112, 0, 0.2);
  }

  .cadastro-fornecedor-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .status-message {
    min-height: 20px;
    text-align: center;
    font-size: 0.9rem;
  }

  .status-message.success {
    color: #7dffb3;
  }

  .status-message.error {
    color: #ff7d7d;
  }

  .privacy-notice {
    display: block;
    text-align: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  @media (max-width: 1100px) {
    .content-grid-cadastro-fornecedor {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 768px) {
    .form-card {
      padding: 22px;
    }

    .cadastro-fornecedor-form label {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .cadastro-fornecedor-form textarea {
      resize: none;
    }
  }
</style>
