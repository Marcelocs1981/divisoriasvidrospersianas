---
import { Image } from 'astro:assets';

/* IMAGENS */
import imgPlaceholder from '../assets/placeholder.webp';
import imgPisoTeto from '../assets/divisoria-de-vidro-duplo-com-persiana-embutida-do-piso-ate-o-teto.webp';
import imgJuntaSeca from '../assets/divisoria-de-vidro-junta-seca-com-persiana-embutida.webp';
import imgAcustica from '../assets/divisoria-de-vidro-acustico-com-persiana-embutida.webp';
import imgIndustrial from '../assets/divisoria-industrial-de-vidro-com-persiana-embutida.webp';
import imgAutomatica from '../assets/divisoria-de-vidro-com-persiana-automatizada.webp';
import imgAluminio from '../assets/divisoria-de-vidro-com-aluminio-e-persiana-embutida.webp';

const produtos = [
  {
    label: "PISO TETO",
    title: "Divisória de vidro duplo com persiana embutida do piso até o teto",
    desc: "Controle preciso por cordão interno entre os vidros. Robusto, silencioso e atemporal.",
    featured: true,
    href: "#orcamento",
    image: imgPisoTeto
  },
  {
    label: "JUNTA SECA",
    title: "Divisória de vidro junta seca com persiana embutida",
    desc: "Menos alumínio e mais elegância com vidros em juntas postas.",
    featured: true,
    href: "#orcamento",
    image: imgJuntaSeca
  },
  {
    label: "ACÚSTICA",
    title: "Divisória de vidro acústico com persiana embutida",
    desc: "Divisórias privativas para reuniões sigilosas.",
    featured: true,
    href: "#orcamento",
    image: imgAcustica
  },
  {
    label: "INDUSTRIAL",
    title: "Divisória industrial de vidro com persiana embutida",
    desc: "Pensada e desenvolvida especialmente para divisão de ambiente industrial.",
    featured: true,
    href: "#orcamento",
    image: imgIndustrial
  },
  {
    label: "AUTOMÁTICA",
    title: "Divisória de vidro com persiana automatizada",
    desc: "Botão é coisa do passado, crie vários cenários e tenha o controle total das persianas intergradas automáticas por comando de voz ou em seu smartphone.",
    featured: true,
    href: "#orcamento",
    image: imgAutomatica
  },
  {
    label: "ALUMÍNIO",
    title: "Divisória em Vidro com Alumínio e persiana embutida",
    desc: "Estética moderna com estrutura marcante.",
    featured: true,
    href: "#orcamento",
    image: imgAluminio
  }
];
---
<section class="produtos">
  <div class="container">

    <!-- HEADER -->
    <div id="modelos" class="header">

      <span class="tag">
        11 MODELOS EXCLUSIVOS
      </span>

      <h2>
        Escolha a divisória em vidro com persiana, que vai <span class="gold"><i>redefinir</i></span> seu escritório.
      </h2>

      <p>
        Cada ambiente é único. Por isso, as <strong class="strong">divisórias de vidro com persianas embutidas</strong>, são projetadas de acordo com sua preferência de design e, fabricadas sob medida em nossa fábrica. Oferecemos garantia total e suporte especializado. Ao longo dos anos, executamos mais de 2.800 projetos em salas comerciais, escritórios de empresas, indústrias e hotéis.
      </p>

    </div>

    <!-- GRID -->
    <div class="grid">

      {produtos.map((item) => (

        <article class={`card ${item.featured ? 'featured' : ''}`}>

          <a
            href={item.href}
            class="image"
            aria-label={item.title}
          >

            <span class="label">
              {item.label}
            </span>

            <Image
              src={item.image}
              alt={item.title}
              widths={[480, 768]}
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="lazy"
              decoding="async"
              format="webp"
            />

          </a>

          <h3>
            <a href={item.href}>
              {item.title}
            </a>
          </h3>

          <p>
            {item.desc}
          </p>

        </article>

      ))}

    </div>

    <!-- CTA -->
    <div class="cta">
      <a href="#orcamento">
        QUERO O MODELO IDEAL DE DIVISÓRIAS DE VIDRO COM PERSIANAS PARA MINHA EMPRESA →
      </a>
    </div>

  </div>
</section>

<style>
.produtos {
  padding: 140px 0;
  background: #050505;
  color: #fff;
}

/* HEADER */
.header {
  max-width: 900px;
  margin-bottom: 80px;
}

.header h2 {
  font-size: clamp(1.6rem, 2.9vw, 2.5rem);
  line-height: 1.05;
  font-weight: 200;
  margin-bottom: 20px;
  letter-spacing: -1px;
  color: #eaeaea;
  max-width: 900px;
}

.header p {
  color: #aaa;
  line-height: 1.7;
  font-size: clamp(0.95rem, 1.3vw, 1.15rem);
}

/* GRID */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

/* CARD */
.card {
  transition: transform 0.3s ease; 
  will-change: transform;
  contain: layout style;
}

.card:hover {
  transform: translateY(-4px);
}

/* LINK IMAGEM */
.image {
  position: relative;

  display: block;

  overflow: hidden;
  border-radius: 10px;

  text-decoration: none;
}

/* IMG */
.image img {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  transition: transform 0.5s ease;
  will-change: transform;          /* NOVO: camada GPU para o scale */
  transform: translateZ(0);        /* NOVO: promoção antecipada */
  content-visibility: auto;        /* NOVO: pula render fora da viewport */
  contain-intrinsic-size: auto 3/2;/* NOVO: reserva espaço proporcional */
}

.card:hover .image img {
  transform: scale(1.03);
}

/* OVERLAY */
.image::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,0.72),
      rgba(0,0,0,0.15),
      transparent
    );
}

/* LABEL */
.label {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 2;
  padding: 6px 10px;
  border-radius: 999px;
  background: #b58a0a;
  color: #ffffff;
  font-size: 10px;
  letter-spacing: 1px;

  backdrop-filter: blur(4px);
}

/* TITULO */
.card h3 {
  margin-top: 18px;
  margin-bottom: 10px;
  line-height: 1.4;
  font-weight: 200;
  font-size: clamp(0.90rem, 1.4vw, 1.4rem);
}

.card h3 a {
  color: #fff;
  text-decoration: none;
  font-weight: 200;
  transition: color 0.25s ease;
}

.card h3 a:hover {
  color: #b58a0a;
}

/* TEXTO */
.card p {
  line-height: 1.5;
  color: #aaa;
  font-size: clamp(0.85rem, 1.1vw, 1rem);
}

.strong {
  color: #ffffff;
}

/* FEATURED */
.featured {
  padding: 12px;
  border: 1px solid rgba(181,138,10,0.25);
  border-radius: 14px;
  background:#1a1a1a;
}

/* RESPONSIVO */
@media (max-width: 900px) {

  .grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {

  .produtos {
    padding: 100px 0;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .header {
    margin-bottom: 50px;
  }

}
</style>