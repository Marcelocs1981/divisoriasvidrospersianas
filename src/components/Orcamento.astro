<section class="orcamento">

  <div class="container">

    <!-- ESQUERDA -->
    <div class="left">

      <span class="tag">
        PRÓXIMO PASSO
      </span>

      <h2>
        Solicite seu projeto<br />
        com <span class="gold-text">orçamento sem compromisso.</span>
      </h2>

      <p class="desc">
        Em poucos minutos, um especialista entrará em contato para entender seu projeto.
        Agende uma visita técnica gratuita com a melhor proposta do mercado e se surpreenda.
      </p>

      <!-- BENEFÍCIOS -->
      <ul class="benefits">

        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
          Visita técnica gratuita com especialista em divisórias de vidro com persianas
        </li>

        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
          Projeto personalizado exclusivo para o escritório da sua empresa
        </li>

        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
          Cartão BNDES e parcelamento sem juros
        </li>

        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
          Garantia total de fábrica de divisória de vidro com persiana
        </li>

      </ul>

    </div>

    <!-- DIREITA -->
    <div class="right" id="orcamento">

      <form
        class="form"
        id="orcamento-form"
        method="POST"
      >

        <div class="grid">

          <div class="field">
            <label for="nome">Nome*</label>

            <input
              type="text"
              id="nome"
              name="nome"
              required
            />
          </div>

          <div class="field">
            <label for="empresa">Empresa</label>

            <input
              type="text"
              id="empresa"
              name="empresa"
            />
          </div>

          <div class="field">
            <label for="email">E-mail*</label>

            <input
              type="email"
              id="email"
              name="email"
              required
            />
          </div>

          <div class="field">
            <label for="telefone">
              Telefone / WhatsApp*
            </label>

            <input
              type="tel"
              id="telefone"
              name="telefone"
              required
            />
          </div>

        </div>

        <div class="field">

          <label for="modelo">
            Modelo de interesse
          </label>

          <input
            type="text"
            id="modelo"
            name="modelo"
            placeholder="Ex.: Vidro duplo com persiana embutida"
          />

        </div>

        <div class="field">

          <label for="mensagem">
            Conte sobre seu projeto
          </label>

          <textarea
            id="mensagem"
            name="mensagem"
            rows="5"
            placeholder="Metragem aproximada, localização, prazo desejado..."
          ></textarea>

        </div>

        <button type="submit">
          SOLICITAR ORÇAMENTO PERSONALIZADO
        </button>

        <p
          class="status-message"
          id="status-message"
        ></p>

        <p class="privacy">
          Ao enviar, você concorda com nossa política de privacidade.
        </p>

      </form>

    </div>

  </div>

</section>

<script>

const form =
  document.getElementById('orcamento-form');

const statusMessage =
  document.getElementById('status-message');

if (form && statusMessage) {

  form.addEventListener(
    'submit',
    async (e) => {

      e.preventDefault();

      const button =
        form.querySelector('button');

      if (!button) return;

      button.disabled = true;

      button.innerText = 'ENVIANDO...';

      statusMessage.innerText = '';

      statusMessage.classList.remove(
        'success',
        'error'
      );

      try {

        const formData =
          new FormData(form);

        const response =
          await fetch('/send.php', {
            method: 'POST',
            body: formData
          });

        const result =
          await response.json();

        if (result.success) {

          statusMessage.innerText =
            'Mensagem enviada com sucesso!';

          statusMessage.classList.add(
            'success'
          );

          form.reset();

        } else {

          statusMessage.innerText =
            'Erro ao enviar mensagem.';

          statusMessage.classList.add(
            'error'
          );

        }

      } catch {

        statusMessage.innerText =
          'Erro ao enviar mensagem.';

        statusMessage.classList.add(
          'error'
        );

      }

      button.disabled = false;

      button.innerText =
        'SOLICITAR ORÇAMENTO PERSONALIZADO';

    }
  );

}

</script>

