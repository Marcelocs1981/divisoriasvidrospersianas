---
interface Props {
  bgMobile?: string;
}

const { bgMobile = "/assets/bg-escolher-mobile.png" } = Astro.props;
---

<header class="topbar" id="topbar">
  <a href="/" class="logo">
    <img
      src="/logo.webp"
      alt="EduColorPrint"
      width="85"
      height="45"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </a>

  <form action="/buscar/" method="GET" role="search" class="search-form">
    <label for="search-input" class="sr-only"
      >Pesquisar desenhos e atividades no site</label
    >
    <input
      type="search"
      name="q"
      id="search-input"
      placeholder="Pesquisar"
      required
    />
    <button type="submit" aria-label="Executar busca">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
  </form>

  <button
    class="menu-toggle"
    id="menu-toggle"
    type="button"
    aria-label="Abrir menu de navegação"
    aria-expanded="false"
    aria-controls="main-nav"
  >
    <span class="hamburger"></span>
  </button>

  <nav
    class="nav"
    id="main-nav"
    aria-label="Menu principal"
    style={`--bg-mobile: url('${bgMobile}');`}
  >
    <ul class="menu-list">
      <li><a href="/">HOME</a></li>

      <li class="dropdown">
        <button
          class="dropdown-toggle"
          type="button"
          aria-haspopup="menu"
          aria-expanded="false">DESENHOS</button
        >
        <ul class="submenu">
          <li><a href="/desenhos-animais/">Animais</a></li>
          <li>
            <a href="/desenhos-super-herois/">Super-Heróis</a>
          </li>
          <li><a href="/desenhos-frutas/">Frutas</a></li>
          <li><a href="/desenhos-animes/">Animes</a></li>
          <li><a href="/desenhos-flores/">Flores</a></li>
          <li><a href="/desenhos-folhas-plantas/">Folhas e Plantas</a></li>
          <li><a href="/desenhos-profissoes/">Profissões</a></li>
          <li><a href="/desenhos-avioes/">Aviões</a></li>
          <li><a href="/desenhos-carros/">Carros</a></li>
          <li><a href="/desenhos-navios/">Navios</a></li>
          <li>
            <a href="/desenhos-datas-comemorativas/"
              >Datas Comemorativas</a
            >
          </li>
        </ul>
      </li>

      <li class="dropdown">
        <button
          class="dropdown-toggle"
          type="button"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          PAPELARIA
        </button>
        <ul class="submenu">
          <li><a href="/papelaria-para-colorir/cartaz/">Cartaz</a></li>
          <li><a href="/papelaria-para-colorir/cartao/">Cartão</a></li>
          <li><a href="/papelaria-para-colorir/calendario/">Calendário</a></li>
          <li><a href="/papelaria-para-colorir/convites/">Convites</a></li>
          <li>
            <a href="/papelaria-para-colorir/certificados/">Certificados</a>
          </li>
        </ul>
      </li>

      <li class="dropdown">
        <button
          class="dropdown-toggle"
          type="button"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          EDUCAÇÃO INFANTIL
        </button>
        <ul class="submenu">
          <li>
            <a
              href="/atividades-educacao-infantil/linguagem-escrita-alfabetizacao/"
            >
              Linguagem e Alfabetização
            </a>
          </li>
          <li>
            <a
              href="/atividades-educacao-infantil/raciocinio-logico-matematica/"
            >
              Raciocínio Lógico e Matemática
            </a>
          </li>
          <li>
            <a href="/atividades-educacao-infantil/natureza-e-sociedade/">
              Natureza e Sociedade
            </a>
          </li>
          <li>
            <a
              href="/atividades-educacao-infantil/atividades-artisticas-e-ludicas/"
            >
              Atividades Artísticas e Lúdicas
            </a>
          </li>
          <li>
            <a
              href="/atividades-educacao-infantil/atividades-artisticas-e-ludicas/"
            >
              Coordenação Motora
            </a>
          </li>
          <li>
            <a href="/atividades-educacao-infantil/datas-comemorativas/">
              Datas Comemorativas
            </a>
          </li>
        </ul>
      </li>
      <li class="dropdown">
        <button
          class="dropdown-toggle"
          type="button"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          ATIVIDADES ESCOLARES
        </button>
        <ul class="submenu">
          <li>
            <a href="/atividade-escolar/lingua-portuguesa/">Língua Portuguesa</a
            >
          </li>
          <li><a href="/atividade-escolar/matematica/">Matemática</a></li>
          <li><a href="/atividade-escolar/ciencias/">Ciências</a></li>
          <li><a href="/atividade-escolar/historia/">História</a></li>
          <li><a href="/atividade-escolar/geografia/">Geografia</a></li>
          <li>
            <a href="/atividade-escolar/apoio-pedagogico/">Apoio Pedagógico</a>
          </li>
        </ul>
      </li>
      <li class="dropdown">
        <button
          class="dropdown-toggle"
          type="button"
          aria-haspopup="menu"
          aria-expanded="false">MOLDES PARA IMPRIMIR</button
        >
        <ul class="submenu">
          <li><a href="/moldes/letras/">Molde de Letras</a></li>
          <li><a href="/moldes/numeros/">Molde de Números</a></li>
          <li><a href="/moldes/herois/">Molde de Heróis</a></li>
          <li>
            <a href="/moldes/datas-comemorativas/"
              >Molde de Datas Comemorativas</a
            >
          </li>
          <li><a href="/moldes/festas/">Molde de Festas</a></li>
          <li><a href="/moldes/flores/">Molde de Flores</a></li>
          <li><a href="/moldes/folhas/">Molde de Folhas</a></li>
          <li><a href="/moldes/animais/">Molde de Animais</a></li>
          <li>
            <a href="/moldes/jardim-encantado/">Molde de Jardim Encantado</a>
          </li>
          <li><a href="/moldes/lacos/">Molde de Laços</a></li>
          <li><a href="/moldes/acessorios/">Molde de Acessórios</a></li>
          <li><a href="/moldes/religiosos/">Moldes Religiosos</a></li>
          <li><a href="/moldes/maos/">Molde de Mãos</a></li>
          <li><a href="/moldes/pes/">Molde de Pés</a></li>
        </ul>
      </li>
      <li><a href="/sobre">SOBRE</a></li>
    </ul>
  </nav>
</header>

<script>
  function initNavigation() {
    const topbar = document.getElementById("topbar");
    const menuToggle = document.getElementById("menu-toggle");
    const nav = document.getElementById("main-nav");
    const menuLinks = document.querySelectorAll(".menu-list a");
    const dropdowns = document.querySelectorAll(".dropdown");

    if (!topbar || !menuToggle || !nav) return;

    if (topbar.dataset.navInit) return;
    topbar.dataset.navInit = "1";

    function closeAllMenus() {
      menuToggle?.setAttribute("aria-expanded", "false");
      menuToggle?.setAttribute("aria-label", "Abrir menu de navegação");
      topbar?.classList.remove("menu-open");
      dropdowns.forEach((d) => {
        d.classList.remove("active");
        d.querySelector(".dropdown-toggle")?.setAttribute(
          "aria-expanded",
          "false",
        );
      });
    }

    function toggleMenu() {
      const isExpanded = menuToggle?.getAttribute("aria-expanded") === "true";
      const nextState = !isExpanded;

      menuToggle?.setAttribute("aria-expanded", nextState.toString());
      menuToggle?.setAttribute(
        "aria-label",
        nextState ? "Fechar menu de navegação" : "Abrir menu de navegação",
      );
      topbar?.classList.toggle("menu-open", nextState);
    }
    menuToggle.addEventListener("click", toggleMenu);

    menuLinks.forEach((link) => {
      link.addEventListener("click", closeAllMenus);
    });

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            topbar.classList.toggle("scrolled", window.scrollY > 40);
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    dropdowns.forEach((dropdown) => {
      const toggle = dropdown.querySelector(".dropdown-toggle");
      if (!toggle) return;

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();

        dropdowns.forEach((other) => {
          if (other !== dropdown) {
            other.classList.remove("active");
            other
              .querySelector(".dropdown-toggle")
              ?.setAttribute("aria-expanded", "false");
          }
        });

        const isActive = dropdown.classList.toggle("active");
        toggle.setAttribute("aria-expanded", isActive.toString());
      });

      dropdown.addEventListener("mouseenter", () => {
        if (window.innerWidth > 992) {
          toggle.setAttribute("aria-expanded", "true");
        }
      });

      dropdown.addEventListener("mouseleave", () => {
        if (window.innerWidth > 992) {
          dropdown.classList.remove("active");
          toggle.setAttribute("aria-expanded", "false");
        }
      });

      dropdown.addEventListener("focusout", () => {
        setTimeout(() => {
          const target = document.activeElement;
          if (target instanceof Element && !dropdown.contains(target)) {
            dropdown.classList.remove("active");
            toggle.setAttribute("aria-expanded", "false");
          }
        }, 0);
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element) {
        const clickedInsideDropdown = target.closest(".dropdown");
        if (!clickedInsideDropdown) {
          dropdowns.forEach((d) => {
            d.classList.remove("active");
            d.querySelector(".dropdown-toggle")?.setAttribute(
              "aria-expanded",
              "false",
            );
          });
        }
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        const activeDropdown = document.querySelector(
          ".dropdown.active, .dropdown:focus-within",
        );
        const activeToggle = activeDropdown?.querySelector(".dropdown-toggle");
        const isMobileMenuOpen = topbar?.classList.contains("menu-open");

        closeAllMenus();

        if (activeToggle instanceof HTMLElement) {
          activeToggle.focus();
        } else if (isMobileMenuOpen && menuToggle instanceof HTMLElement) {
          menuToggle.focus();
        }
      }
    });
  }

  initNavigation();
  document.addEventListener("astro:after-swap", initNavigation);
</script>

<style>
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #ffffff;
    border-bottom: 2px solid #f5f5f5;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem; /* Reduzido levemente para dar mais margem aos links */
    will-change: background-color, backdrop-filter, box-shadow, padding;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      padding 0.25s ease;
  }

  .topbar.scrolled {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    padding: 10px 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo img {
    width: 85px;
    height: 45px;
    aspect-ratio: 85 / 45;
    display: block;
    transition:
      width 0.25s ease,
      height 0.25s ease;
  }

  .topbar.scrolled .logo img {
    width: 72px;
    height: 38px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-form {
    flex-grow: 1;
    max-width: 320px; /* Sutil redução no tamanho da barra para abrir espaço para o menu textudo */
    display: flex;
    align-items: center;
    background-color: #f1f2f6;
    border-radius: 50px;
    padding: 4px 6px 4px 16px;
    border: 2px solid transparent;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .search-form:focus-within {
    border-color: #ff4757;
    background-color: #ffffff;
  }

  .search-form input {
    border: none;
    background: transparent;
    outline: none;
    padding: 6px 0;
    font-size: 0.9rem;
    width: 100%;
    color: #2f3542;
  }

  .search-form button {
    background: transparent;
    border: none;
    color: #747d8c;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 20px; /* Espaçamento ideal entre os links em resoluções comuns de desktop */
  }

  .menu-list li {
    display: flex;
    align-items: center;
    height: 100%; /* Garante que ocupem toda a altura disponível da topbar */
  }

  /* SOLUÇÃO CSS APLICADA: Impede a quebra de linha de termos compostos */
  .menu-list a,
  .dropdown-toggle {
    color: #4a4a4a;
    text-decoration: none;
    font-size: 0.83rem;
    font-weight: 500;
    letter-spacing: 0px;
    white-space: nowrap;
    transition: color 0.2s ease;

    /* --- ADICIONE AS LINHAS ABAIXO PARA CORRIGIR O ALINHAMENTO --- */
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
  }

  .menu-list a:hover,
  .dropdown-toggle:hover {
    color: #ff4757;
  }

  .dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .dropdown-toggle {
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }

  .submenu {
    list-style: none;
    position: absolute;
    top: 100%;
    left: -16px;
    min-width: 200px;
    padding: 14px 0 0 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    will-change: transform, opacity;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;
    z-index: 99;
  }

  .submenu::before {
    content: "";
    position: absolute;
    inset: 10px 0 0 0; /* Reduzido o recuo do topo do balão */
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    z-index: -1;
  }

  .submenu a {
    display: block;
    padding: 6px 18px; /* Reduzido o espaçamento vertical de 12px para 6px */
    font-size: 0.88rem;
    font-weight: 400; /* Fonte mais fina e elegante */
    color: #4a4a4a;
    border-radius: 6px;
    white-space: nowrap; /* Garante que o texto da subcategoria não quebre linha no desktop */
  }

  .submenu a:hover {
    background: #fff5f6;
    color: #ff4757;
  }

  @media (min-width: 993px) {
    .dropdown:hover .submenu,
    .dropdown.active .submenu,
    .dropdown:focus-within .submenu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    width: 36px;
    height: 36px;
    position: relative;
    cursor: pointer;
    z-index: 110;
    -webkit-tap-highlight-color: transparent;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    width: 24px;
    height: 2.5px;
    background: #2f3542;
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .hamburger {
    top: 50%;
    left: 6px;
    transform: translateY(-50%);
  }
  .hamburger::before {
    top: -7px;
    left: 0;
  }
  .hamburger::after {
    top: 7px;
    left: 0;
  }

  .topbar.menu-open .hamburger {
    background: transparent;
  }
  .topbar.menu-open .hamburger::before {
    transform: translateY(7px) rotate(45deg);
  }
  .topbar.menu-open .hamburger::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 992px) {
    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .search-form {
      position: absolute;
      top: 90px;
      left: 32px;
      right: 32px;
      width: calc(100% - 64px);
      max-width: none;
      z-index: 106;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0.25s ease;
    }

    .topbar.menu-open .search-form {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100svh;
      padding: 160px 32px 40px;
      background-color: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-8px);
      will-change: transform, opacity;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0.25s ease;
      overflow-y: auto;
      z-index: 105;
    }

    .nav::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--bg-mobile);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      opacity: 0.04;
      z-index: -1;
    }

    .topbar.menu-open .nav {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .menu-list {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 24px;
    }

    .menu-list li {
      width: 100%;
      display: flex;
      align-items: center;
    }

    /* Modificado no mobile para herdar os tamanhos de fonte grandes do layout original */
    .menu-list a,
    .dropdown-toggle {
      font-size: 1.2rem;
      font-weight: 500;
      width: 100%;
      text-align: left;
      color: #2f3542;
      display: block;
      white-space: normal; /* Permite quebras no mobile se a tela do aparelho for muito pequena */
    }

    .dropdown {
      flex-direction: column;
      align-items: flex-start;
    }

    .submenu {
      position: static;
      width: 100%;
      min-width: auto;
      padding: 0 0 0 16px;
      margin-top: 4px;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      transform: none;
      will-change: max-height, opacity;
      transition:
        max-height 0.25s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.2s ease;
    }

    .submenu::before {
      display: none;
    }
    .submenu a {
      padding: 10px 0;
      font-size: 1rem;
      color: #747d8c;
    }
    .dropdown.active .submenu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      max-height: 600px; /* Aumentado levemente para comportar com folga a lista de desenhos */
    }
  }
</style>
