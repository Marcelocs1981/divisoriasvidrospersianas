---
const diferenciais = [
  {
    title: 'Conforto Acústico',
    desc: 'Reuniões confidenciais sem se preocupar com conversas vazadas. Vidro duplo que isola até 42dB.',
    icon: `
      <path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path>
      <path d="M16 9a5 5 0 0 1 0 6"></path>
      <path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path>
    `
  },
  {
    title: 'Conforto Térmico',
    desc: 'A persiana entre os vidros bloqueia o sol e regula a temperatura. Menos ar-condicionado, mais economia.',
    icon: `
      <path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"></path>
    `
  },
  {
    title: 'Conforto Visual',
    desc: 'Luz natural quando você quer, sombra quando precisa. Acabe com reflexos no monitor e fadiga ocular.',
    icon: `
      <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
      <circle cx="12" cy="12" r="3"></circle>
    `
  },
  {
    title: 'Privacidade Total',
    desc: 'Um clique e o ambiente fica completamente reservado. Da transparência ao sigilo em segundos.',
    icon: `
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    `
  },
  {
    title: 'Elegância Sob Medida',
    desc: 'Linhas limpas, acabamento impecável e design atemporal para impressionar clientes e parceiros.',
    icon: `
      <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path>
    `
  },
  {
    title: 'Autoridade Visual',
    desc: 'Clientes, investidores e parceiros sentem a diferença assim que entram no ambiente.',
    icon: `
      <path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path>
      <path d="M5 21h14"></path>
    `
  }
];
---

<section
  id="diferenciais"
  class="section-padrao"
  aria-labelledby="diferenciais-heading"
>
  <div class="container">
    
    <header class="section-header">
      <span class="tag">POR QUE SUA EMPRESA MERECE</span>
      <h2 id="diferenciais-heading">
        Cada detalhe é pensado para
        <span class="goldgradient">elevar a percepção de valor do seu negócio.</span>
      </h2>
    </header>

    <ul class="grid-diferenciais">
      {
        diferenciais.map((item) => (
          <li class="card">
            <svg
              class="icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={item.icon}
            />
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  #diferenciais {
    overflow: hidden;
  }

   /* ESTRUTURA DO GRID OTIMIZADA (Sem divs extras de linha) */
  .grid-diferenciais {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)); /* Correção aqui */
    list-style: none; /* Remove marcadores da tag ul/li */
  }

  /* COMPORTAMENTO DO CARD */
  .card {
    padding: 50px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    /* Margem negativa inteligente faz as bordas se sobreporem perfeitamente sem duplicar a espessura */
    margin: -0.5px; 
    transition: border-color 0.25s ease, transform 0.25s ease;
    contain: layout paint; /* Melhora drástica na performance de renderização */
  }

  /* EFEITO DE INTERAÇÃO */
  .card:hover {
    border-color: #b58a0a;
    transform: translateY(-6px);
    z-index: 2; /* Garante que a borda dourada fique por cima das caixas vizinhas */
  }

  /* ÍCONE */
  .icon {
    width: 24px;
    height: 24px;
    margin-bottom: 20px;
    color: #b58a0a;
    display: block;
  }

  /* SUBTÍTULOS DOS CARDS (O espaçamento inferior já é herdado do global, apenas refinamos) */
  h3 {
    font-size: clamp(1.2rem, 1.5vw, 1.35rem);
    font-weight: 400;
  }

  /* TEXTO INTERNO: Configurações finas locais */
  .card p {
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(0.92rem, 1vw, 1rem);
  }

  /* RESPONSIVO INTERMEDIÁRIO (TABLETS / NOTEBOOKS PEQUENOS) */
  @media (max-width: 1024px) {
    .grid-diferenciais {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* RESPONSIVO MOBILE (SMARTPHONES) */
  @media (max-width: 768px) {
    .section-header h2 {
      margin-bottom: 35px;
    }

    .grid-diferenciais {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 35px 25px;
    }
  }
</style>