---
/* Orcamento.astro */

interface Props {
  cidade?: string;
  produto?: string;
}

const { cidade = "", produto = "Divisórias de Vidro com Persianas" } =
  Astro.props;

const textoDestaque = cidade
  ? `orçamento sem compromisso em ${cidade}.`
  : "orçamento sem compromisso.";

const beneficioLocal = cidade
  ? `Atendimento rápido e personalizado para empresas em ${cidade} e região.`
  : "Projeto personalizado exclusivo para o escritório da sua empresa.";
---

<section
  id="orcamento"
  class="section-padrao container content-grid-orcamento"
  aria-labelledby="orcamento-heading"
>
  <aside class="orcamento-info">
    <header>
      <span class="tag">PRÓXIMO PASSO</span>
      <h2 id="orcamento-heading">
        Solicite seu projeto com <strong class="goldgradient"
          >{textoDestaque}</strong
        >
      </h2>
    </header>

    <p class="orcamento-description">
      Em poucos minutos, um especialista entrará em contato para entender seu
      projeto. Agende uma visita técnica gratuita com a melhor proposta do
      mercado e se surpreenda.
    </p>

    <ul class="benefits-list" role="list">
      <li>
        <span class="check-icon" aria-hidden="true">✓</span>
        <span>Visita técnica gratuita com especialista em {produto}.</span>
      </li>
      <li>
        <span class="check-icon" aria-hidden="true">✓</span>
        <span>{beneficioLocal}</span>
      </li>
      <li>
        <span class="check-icon" aria-hidden="true">✓</span>
        <span>Pague com cartão BNDES e parcelamento sem juros.</span>
      </li>
      <li>
        <span class="check-icon" aria-hidden="true">✓</span>
        <span
          >Garantia total direto da nossa fábrica de divisória de vidro com
          persianas.</span
        >
      </li>
    </ul>
  </aside>

  <form
    class="orcamento-form form-card"
    id="orcamento-form"
    method="POST"
    autocomplete="on"
  >
    <input type="hidden" name="origem_produto" value={produto} />
    <input type="hidden" name="origem_cidade" value={cidade} />
    <input type="hidden" id="page-title-input" name="titulo_pagina" value="" />

    <label for="nome">
      <span>Nome*</span>
      <input type="text" id="nome" name="nome" autocomplete="name" required />
    </label>

    <label for="empresa">
      <span>Empresa</span>
      <input
        type="text"
        id="empresa"
        name="empresa"
        autocomplete="organization"
      />
    </label>

    <label for="email">
      <span>E-mail*</span>
      <input
        type="email"
        id="email"
        name="email"
        autocomplete="email"
        inputmode="email"
        required
      />
    </label>

    <label for="telefone">
      <span>Telefone*</span>
      <input
        type="tel"
        id="telefone"
        name="telefone"
        autocomplete="tel"
        inputmode="tel"
        required
      />
    </label>

    <label for="mensagem" class="label-textarea">
      <span>Conte sobre seu projeto</span>
      <textarea
        id="mensagem"
        name="mensagem"
        rows="5"
        placeholder="Metragem aproximada, localização, prazo desejado..."
      ></textarea>
    </label>

    <button type="submit" aria-label="Solicitar orçamento personalizado">
      SOLICITAR ORÇAMENTO
    </button>

    <output id="status-message" class="status-message" aria-live="polite"
    ></output>

    <small class="privacy-notice">
      ⚠️ Ao enviar, você concorda com nossa política de privacidade.
    </small>
  </form>
</section>

<script>
  const form = document.getElementById("orcamento-form") as HTMLFormElement;
  const statusMessage = document.getElementById("status-message");
  const pageTitleInput = document.getElementById(
    "page-title-input",
  ) as HTMLInputElement;

  if (form && statusMessage) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = form.querySelector("button");
      if (!button) return;

      if (pageTitleInput) {
        pageTitleInput.value = document.title;
      }

      form.setAttribute("aria-busy", "true");
      button.disabled = true;
      button.textContent = "ENVIANDO...";
      statusMessage.textContent = "";
      statusMessage.classList.remove("success", "error");

      try {
        const formData = new FormData(form);
        const response = await fetch("/send.php", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          statusMessage.textContent = "Mensagem enviada com sucesso!";
          statusMessage.classList.add("success");
          form.reset();
        } else {
          statusMessage.textContent = "Erro ao enviar mensagem.";
          statusMessage.classList.add("error");
        }
      } catch {
        statusMessage.textContent = "Erro ao enviar mensagem.";
        statusMessage.classList.add("error");
      } finally {
        form.setAttribute("aria-busy", "false");
        button.disabled = false;
        button.textContent = "SOLICITAR ORÇAMENTO";
      }
    });
  }
</script>

<style>
  /* REGRAS DE CONTAINER ADAPTADAS PARA A TAG PRINCIPAL */
  .container {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  .content-grid-orcamento {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 60px;
    align-items: center;
  }

  .section-padrao::before {
    content: "";
    position: absolute;
    top: -100px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      rgba(150, 112, 0, 0.25) 0%,
      transparent 70%
    );

    filter: blur(80px);
    pointer-events: none;
  }

  .orcamento-info h2 {
    margin-bottom: 28px;
  }

  .orcamento-description {
    margin-bottom: 22px;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 40px 0 0 0;
  }

  .benefits-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
    color: #c7c7c7;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    line-height: 1.5;
  }

  .check-icon {
    color: #967000;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* O FORMULÁRIO AGORA ABRAÇA OS ESTILOS VISUAIS DO CARD */
  .form-card {
    background: rgba(20, 20, 20, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 30px;
    backdrop-filter: blur(8px);
  }

  .orcamento-form {
    display: grid;
    gap: 18px;
  }

  .orcamento-form label {
    display: grid;
    grid-template-columns: 160px 1fr;
    align-items: center;
    gap: 14px;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .orcamento-form .label-textarea {
    align-items: start;
  }

  .orcamento-form input,
  .orcamento-form textarea {
    width: 100%;
    background: #050505;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: #fff;
    padding: 14px 16px;
    font-size: 0.95rem;
    outline: none;
    box-sizing: border-box;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .orcamento-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .orcamento-form input::placeholder,
  .orcamento-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .orcamento-form input:focus,
  .orcamento-form textarea:focus {
    border-color: rgba(150, 112, 0, 0.7);
    box-shadow:
      0 0 0 1px rgba(150, 112, 0, 0.25),
      0 0 18px rgba(150, 112, 0, 0.08);
  }

  .orcamento-form button {
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: 4px;
    background: linear-gradient(180deg, #c89d37, #967000);
    color: #000;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .orcamento-form button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(150, 112, 0, 0.2);
  }

  .orcamento-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .status-message {
    min-height: 20px;
    text-align: center;
    font-size: 0.9rem;
  }

  .status-message.success {
    color: #7dffb3;
  }
  .status-message.error {
    color: #ff7d7d;
  }

  .privacy-notice {
    display: block;
    text-align: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  @media (max-width: 1100px) {
    .content-grid-orcamento {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 768px) {
    .form-card {
      padding: 22px;
    }

    .orcamento-form label {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .orcamento-form textarea {
      resize: none;
    }
  }
</style>
