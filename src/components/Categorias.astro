---
interface Props {
  id: string;
  tagTopo: string;
  tituloSecao: string;
  textoApoio: string;
  listaDados: Array<{
    label: string;
    title: string;
    alt: string;
    desc: string;
    image: string;
    slug: string;
    textoBotao: string;
    isAds: boolean;
    gridClass?: string; // Opcional para o mosaico
  }>;
  layout?:
    | "mosaico"
    | "cards"
    | "abas"
    | "abas-verticais"
    | "cards-animados"
    | "split"; // Atualizado com o modelo split
  urlCta?: string;
  textoCta?: string;
}

const {
  id,
  tagTopo,
  tituloSecao,
  textoApoio,
  listaDados,
  layout = "cards",
  urlCta,
  textoCta,
} = Astro.props;

// Filtra os dados de manutenção uma única vez no build
const imagens = import.meta.glob<{ default: ImageMetadata }>("../assets/*.{jpeg,jpg,png,gif,webp}", { eager: true });

const categoriasValidas =
  (listaDados?.filter((item) => item.slug && !item.isAds) || []).map((item) => {
    let resolvedImage = item.image;
    if (typeof item.image === "string") {
      let chave = item.image;
      if (item.image.startsWith("/") || item.image.startsWith("src/")) {
        chave = item.image.replace(/^\//, "").replace(/^src\//, "../");
      } else if (!item.image.startsWith(".")) {
        chave = `../assets/${item.image}`;
      }
      const imgMeta = imagens[chave];
      if (imgMeta) {
        resolvedImage = imgMeta.default.src;
      }
    }
    return {
      ...item,
      image: resolvedImage,
    };
  });

// Se não houver itens válidos, o componente já mata a execução aqui poupando o build
if (categoriasValidas.length === 0) return null;

// Verifica se o layout atual pertence à família de abas/pastas
const isLayoutAbas = layout === "abas" || layout === "abas-verticais";
---

<section id={id} class="secao-categorias-pai" aria-labelledby={`${id}-heading`}>
  <div class="container-categorias-global">
    <header class="topo-secao">
      <span class="tag">{tagTopo}</span>
      <h2 id={`${id}-heading`} set:html={tituloSecao} />
      <p class="texto-apoio">{textoApoio}</p>
    </header>

    {
      isLayoutAbas && (
        <div
          class={`arquivo-pastas layout-${layout === "abas" ? "abas-horiz" : "abas-vert"}`}
        >
          {categoriasValidas.map((item, index) => (
            <div class="item-aba-pasta">
              <input
                type="radio"
                name={`abas-${id}`}
                id={`aba-${id}-${index}`}
                class="radio-aba-oculto"
                checked={index === 0}
              />
              <label for={`aba-${id}-${index}`} class="aba-pasta">
                <span>{item.label}</span>
              </label>

              <div class="corpo-pasta">
                <div class="conteudo-interno-pasta">
                  <div class="bloco-texto-pasta">
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                    <a href={item.slug} class="cta-pasta">
                      {item.textoBotao || "Ver Atividades para Imprimir"}{" "}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </a>
                  </div>
                  <div class="bloco-midia-pasta">
                    <div class="moldura-imagem-reduzida">
                      <img
                        src={item.image}
                        alt={item.alt}
                        loading={index === 0 ? "eager" : "lazy"}
                        decoding="async"
                        width="500"
                        height="500"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      layout === "cards-animados" && (
        <div class="grid-cards-animados">
          {categoriasValidas.map((item) => (
            <article class="card-interativo">
              <div class="card__category">
                <a href={item.slug}>{item.label}</a>
              </div>
              <header class="card__thumb">
                <a
                  href={item.slug}
                  aria-label={`Acessar conteúdo de ${item.title}`}
                >
                  <img
                    src={item.image}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    width="370"
                    height="245"
                  />
                </a>
              </header>
              <div class="card__body">
                <h3 class="card__title">
                  <a href={item.slug}>{item.title}</a>
                </h3>
                <p class="card__description">{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      layout === "split" && (
        <div class="grid-split">
          {categoriasValidas.map((item) => (
            <a
              href={item.slug}
              class="card-split"
              aria-label={`Ir para ${item.title}`}
            >
              <div class="split-midia">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    width="150"
                    height="150"
                  />
                ) : (
                  <div class="split-midia-inner">PDF</div>
                )}
              </div>
              <div class="split-conteudo">
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </a>
          ))}
        </div>
      )
    }

    {
      !isLayoutAbas && layout !== "cards-animados" && layout !== "split" && (
        <ol class={`lista-conteudos-grid layout-${layout}`}>
          {categoriasValidas.map((item) => (
            <li
              class={`card-categoria-grid ${layout === "mosaico" ? item.gridClass || "cat-normal" : "card-grid-padrao"}`}
            >
              <div class="wrapper-conteudo-categoria">
                <span class="rotulo-categoria">{item.label}</span>

                <div class="midia-categoria">
                  <img
                    src={item.image}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="400"
                  />
                </div>

                <div class="mascara-opacidade" />

                <div class="bloco-texto-categoria">
                  <h3>{item.title}</h3>
                  <p class="desc-categoria">{item.desc}</p>
                </div>

                <a
                  href={item.slug}
                  class="link-expandido-categoria"
                  aria-label={`Ir para ${item.title}`}
                />
              </div>
            </li>
          ))}
        </ol>
      )
    }

    {
      urlCta && textoCta && (
        <footer class="rodape-secao-categoria">
          <a href={urlCta} class="cta-geral">
            {textoCta}
          </a>
        </footer>
      )
    }
  </div>
</section>

<style>
  /* ==========================================================================
     ESTILOS COMPARTILHADOS / TOPO
     ========================================================================== */
  .secao-categorias-pai {
    width: 100%;
    padding: 60px 0;
  }
  .container-categorias-global {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .topo-secao h2 {
    font-size: 2.2rem;
    color: #1a202c;
    font-weight: 500;
    margin-top: 10px;
    margin-bottom: 8px;
  }
  .texto-apoio {
    color: #747d8c;
    font-size: 1rem;
    margin-bottom: 40px;
  }
  .rodape-secao-categoria {
    margin-top: 40px;
    text-align: center;
  }
  .cta-geral {
    display: inline-block;
    padding: 14px 28px;
    background: #1a202c;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: 30px;
    transition: background 0.2s;
  }
  .cta-geral:hover {
    background: #2d3748;
  }

  /* ==========================================================================
     LAYOUTS DE GRID (MOSAICO E CARDS REGULARES)
     ========================================================================== */
  .lista-conteudos-grid {
    list-style: none;
    padding: 0;
    margin: 24px 0 0 0;
  }
  .card-categoria-grid {
    position: relative;
    overflow: hidden;
    background: #f1f2f6;
    contain: layout paint;
  }
  .wrapper-conteudo-categoria {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    position: relative;
    z-index: 1;
  }
  .rotulo-categoria {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 5;
    background: var(--color-accent);
    color: var(--text-muted);
    font-size: 0.65rem;
    font-weight: 600; /* Aumentado para 600 para melhorar a leitura sobre fundo colorido */
    letter-spacing: 0.5px;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    pointer-events: none;
  }
  .midia-categoria {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .midia-categoria img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .card-categoria-grid:hover .midia-categoria img {
    transform: scale(1.04);
  }
  .mascara-opacidade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85),
      rgba(0, 0, 0, 0.1)
    );
  }
  .bloco-texto-categoria {
    position: relative;
    z-index: 3;
    padding: 24px;
  }
  .bloco-texto-categoria h3 {
    color: #fff;
    margin: 0 0 8px 0;
    font-size: 1.3rem;
    font-weight: 500;
  }
  .bloco-texto-categoria p.desc-categoria {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    margin: 0;
  }
  .link-expandido-categoria {
    position: absolute;
    inset: 0;
    z-index: 4;
  }

  .layout-mosaico {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: 16px;
  }
  .layout-mosaico .card-categoria-grid {
    border-radius: 18px;
  }
  .layout-mosaico .cat-normal {
    grid-column: span 1;
    grid-row: span 1;
  }
  .layout-mosaico .cat-medio-h {
    grid-column: span 2;
    grid-row: span 1;
  }
  .layout-mosaico .cat-medio-v {
    grid-column: span 1;
    grid-row: span 2;
  }
  .layout-mosaico .cat-grande {
    grid-column: span 2;
    grid-row: span 2;
  }

  .layout-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .layout-cards .card-categoria-grid {
    margin: -0.5px;
    border-radius: 0px;
    border: 1px solid rgba(26, 32, 44, 0.12);
    transition:
      border-color 0.25s,
      transform 0.25s;
    min-height: 260px;
  }
  .layout-cards .card-categoria-grid:hover {
    border-color: #1a202c;
    transform: translateY(-6px);
  }

  /* ==========================================================================
     SISTEMA DE PASTAS BASE (ESTILOS ESTRUTURAIS)
     ========================================================================== */
  .arquivo-pastas {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 20px auto 0 auto;
    box-sizing: border-box;
  }
  .radio-aba-oculto {
    display: none;
  }
  .aba-pasta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f1f2f6;
    border: 1px solid rgba(26, 32, 44, 0.1);
    font-size: 0.85rem;
    font-weight: 700;
    color: #747d8c;
    cursor: pointer;
    z-index: 1;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
    white-space: nowrap;
    text-align: center;
  }
  .aba-pasta:hover {
    background: #e4e7ed;
    color: #1a202c;
  }
  .corpo-pasta {
    background: #ffffff;
    border: 1px solid rgba(26, 32, 44, 0.12);
    border-radius: 16px;
    padding: 40px;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    z-index: 0;
    transition:
      opacity 0.25s,
      transform 0.25s,
      visibility 0.25s;
  }

  .radio-aba-oculto:checked + .aba-pasta {
    background: #ffffff;
    color: #1a202c;
    border-color: rgba(26, 32, 44, 0.12);
    z-index: 3;
  }
  .radio-aba-oculto:checked ~ .corpo-pasta {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    z-index: 2;
  }

  /* Conteúdo Interno Comum da Pasta */
  .conteudo-interno-pasta {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
  }
  .bloco-texto-pasta h3 {
    font-size: 1.6rem;
    color: #1a202c;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .bloco-texto-pasta p {
    color: #4a5568;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .cta-pasta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: #1a202c;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: 30px;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .cta-pasta:hover {
    background: #2d3748;
    transform: translateY(-2px);
  }
  .bloco-midia-pasta {
    display: flex;
    justify-content: center;
  }
  .moldura-imagem-reduzida {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 1/1;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
  .moldura-imagem-reduzida img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ==========================================================================
     VARIAÇÃO A: ARQUIVO DE ABAS HORIZONTAIS (.layout-abas-horiz)
     ========================================================================== */
  .layout-abas-horiz {
    display: flex;
    flex-wrap: wrap;
    min-height: 380px;
  }
  .layout-abas-horiz .aba-pasta {
    padding: 12px 20px;
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    margin-right: 4px;
    position: relative;
    top: 1px;
  }
  .layout-abas-horiz .corpo-pasta {
    width: 100%;
    border-top-left-radius: 0px;
    position: absolute;
    top: 45px;
    left: 0;
    right: 0;
  }
  .layout-abas-horiz .radio-aba-oculto:checked + .aba-pasta {
    border-bottom: 1px solid #ffffff;
    padding-bottom: 13px;
  }

  /* ==========================================================================
     VARIAÇÃO B: ARQUIVO DE ABAS VERTICAIS (.layout-abas-vert)
     ========================================================================== */
  .layout-abas-vert {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 0px;
    min-height: 420px;
  }
  .layout-abas-vert .item-aba-pasta {
    display: contents;
  }
  .layout-abas-vert .aba-pasta {
    grid-column: 1;
    padding: 16px 20px;
    border-right: none;
    border-radius: 12px 0 0 12px;
    margin-bottom: 6px;
    justify-content: flex-start;
    position: relative;
    left: 1px;
  }
  .layout-abas-vert .corpo-pasta {
    grid-column: 2;
    grid-row: 1 / span 999;
    border-top-left-radius: 0px;
  }
  .layout-abas-vert .radio-aba-oculto:checked + .aba-pasta {
    border-right: 1px solid #ffffff;
    padding-right: 21px;
  }

  /* ==========================================================================
     GRID DE CARDS INTERATIVOS (.grid-cards-animados)
     ========================================================================== */
  .grid-cards-animados {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 24px;
    width: 100%;
  }
  .card-interativo {
    position: relative;
    width: 100%;
    background-color: #fff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border-radius: 16px;
    overflow: hidden;
    transition:
      box-shadow 0.5s,
      transform 0.3s;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }
  .card-interativo a {
    color: inherit;
    text-decoration: none;
  }
  .card-interativo:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
    transform: translateY(-4px);
  }
  .card__thumb {
    max-height: 220px;
    overflow: hidden;
    background-color: #000;
    position: relative;
    transition: max-height 0.4s ease;
  }
  .card-interativo:hover .card__thumb {
    max-height: 120px;
  }
  .card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 0.5s,
      transform 0.5s;
  }
  .card-interativo:hover .card__thumb img {
    opacity: 0.8;
    transform: scale(1.05);
  }
  .card__body {
    position: relative;
    padding: 24px 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background: #fff;
    z-index: 2;
  }
  .card__category {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 10;
    height: 30px;
    padding: 0 16px;
    background: #1a202c;
    color: #fff;
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 30px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  .card__title {
    margin: 10px 0 0 0;
    padding: 0;
    color: #1a202c;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .card__description {
    margin: 12px 0 0 0;
    padding: 0;
    color: #4a5568;
    font-size: 0.95rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    opacity: 0;
    max-height: 0;
    transform: translateY(10px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      max-height 0.25s ease;
  }

  .card-interativo:hover .card__description {
    opacity: 1;
    max-height: 4.5rem;
    transform: translateY(0);
  }

  /* ==========================================================================
     NOVO LAYOUT: CARD HORIZONTAL (.layout-split)
     ========================================================================== */
  .grid-split {
    display: grid;
    grid-template-columns: repeat(
      2,
      1fr
    ); /* 2 colunas perfeitas para subcategorias */
    gap: 20px;
    margin-top: 24px;
    width: 100%;
  }
  .card-split {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    display: flex;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    color: #2d3748;
  }
  .card-split:hover {
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }
  .split-midia {
    width: 130px; /* Largura fixa ideal para o box esquerdo */
    min-width: 130px;
    background: #f7fafc;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #e2e8f0;
    overflow: hidden;
  }
  .split-midia img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .split-midia-inner {
    font-weight: 800;
    color: #a0aec0;
    font-size: 1.2rem;
    letter-spacing: 1px;
  }
  .split-conteudo {
    position: relative;
    padding: 20px 24px 20px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    box-sizing: border-box;
    margin-left: 10px;
    overflow: hidden;
    z-index: 1;
  }

  .split-conteudo::before {
    content: "";
    position: absolute;
    left: -10px;
    top: 0;
    bottom: 0;
    width: 2px;
    border-left: 2px dashed #94a3b8;
    pointer-events: none;
    z-index: 0;
  }

  .split-conteudo::after {
    content: "";
    position: absolute;
    inset: 0;
    border-top: 2px dashed #94a3b8;
    border-right: 2px dashed #94a3b8;
    border-bottom: 2px dashed #94a3b8;
    border-left: 0;
    border-radius: 0 12px 12px 0;
    pointer-events: none;
    z-index: 0;
  }
  .split-conteudo h3 {
    margin: 0 0 6px 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: #1a202c;
  }
  .split-conteudo p {
    margin: 0 0 12px 0;
    font-size: 0.9rem;
    color: #718096;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .btn-split {
    font-size: 0.85rem;
    font-weight: 700;
    color: #3182ce; /* Cor de link ativa para indicar ação */
    transition: color 0.2s;
  }
  .card-split:hover .btn-split {
    color: #2b6cb0;
  }

  /* ==========================================================================
     RESPONSIVIDADE GERAL
     ========================================================================== */
  @media (max-width: 1024px) {
    .layout-cards,
    .grid-cards-animados,
    .grid-split {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 992px) {
