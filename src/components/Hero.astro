---
import { Image, getImage } from 'astro:assets';

import imgDesktop from '../assets/divisorias-de-vidros-com-persianas-1920px.webp';
import imgMobile from '../assets/divisorias-de-vidros-com-persianas-768x1080.webp';

const mobileOptimized = await getImage({
  src: imgMobile,
  width: 768,
  quality: 45,
  format: 'webp'
});
---

<section class="hero">

  <!-- BACKGROUND -->
  <div class="bg">

    <picture>

      <!-- MOBILE -->
      <source
        media="(max-width: 767px)"
        srcset={mobileOptimized.src}
        type="image/webp"
      />

      <!-- DESKTOP -->
      <Image
        src={imgDesktop}
        alt="Divisórias de vidro com persianas embutidas instaladas em escritório"
        widths={[1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={45}
        format="webp"
        decoding="async"
      />

    </picture>

    <div class="overlay"></div>

  </div>

  <!-- HEADER -->
  <header class="topbar">

    <div class="wrapper">

      <a href="#" class="logo" aria-label="Divisórias de Vidros com Persianas - página inicial">

        <div class="logo-box">
          DVP
        </div>

        <div class="logo-text">
          Divisórias de Vidros com Persianas<span>.</span>
        </div>

      </a>

      <nav aria-label="Menu principal">
        <a href="#modelos">Modelos</a>
        <a href="#diferenciais">Diferenciais</a>
        <a href="#processo">Processo</a>
        <a href="#orcamento">Orçamento</a>
      </nav>

    </div>

  </header>

  <!-- CONTEÚDO -->
  <div class="container">

    <div class="content">

      <h1>
        O ambiente que <span class="gold">impressiona</span><br />
        clientes, investidores e parceiros de negócios,
        sem precisar dizer uma <span class="gold">palavra</span>.
      </h1>

      <p>
        Divisória em vidro duplo com persiana embutida, aumenta o valor da sua marca, com
        <b>competência e profissionalismo</b> — através de conforto, estilo e sofisticação.
      </p>

      <div class="buttons" role="group" aria-label="Ações principais">

        {/*<a href="#orcamento" class="btn primary">
          SOLICITAR PROJETO SOB MEDIDA
        </a>
         */}
        <a href="#modelos" class="btn secondary">
          VER MODELOS DE DIVISÓRIAS DE VIDROS COM PERSIANAS
        </a>

      </div>

      <dl class="stats">

        <div>
          <dt><strong>+21</strong></dt>
          <dd>anos no mercado</dd>
        </div>

        <div>
          <dt><strong>+800</strong></dt>
          <dd>projetos entregues</dd>
        </div>

        <div>
          <dt><strong>100%</strong></dt>
          <dd>fabricação própria</dd>
        </div>

        <div>
          <dt><strong>Pagamento</strong></dt>
          <dd>com cartão BNDES</dd>
        </div>

      </dl>

    </div>

  </div>

</section>

<style>
.hero {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* BACKGROUND */

.bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.bg picture {
  width: 100%;
  height: 100%;
  display: block;
  position: relative;
  z-index: 0;
}

.bg img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  position: relative;
  z-index: 0;
}

/* OVERLAY */
.overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(0,0,0,0.55);
}

/* LAYOUT */
.wrapper {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

/* TOPBAR */

.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.topbar .wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 20px;
}

/* LOGO */

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: #fff;
}

.logo-box {
  width: 42px;
  height: 42px;
  background: #b58a0a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #000;
  font-weight: 700;
  flex-shrink: 0;
}

.logo-text {
  font-size: clamp(0.7rem, 1.5vw, 1.15rem);
}

.logo-text span {
  color: #b58a0a;
}

/* MENU */

nav {
  display: flex;
  gap: 28px;
}

nav a {
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.3s ease;
}

nav a:hover {
  color: #b58a0a;
}

/* CONTEÚDO */

.container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 140px 20px 80px;
}

.content {
  max-width: 720px;
  padding-top: 50px;
}

/* TÍTULO */

.hero h1 {
  font-size: 2.4rem;
  line-height: 1.05;
  font-weight: 500;
  margin-bottom: 28px;
  text-align: left;
  color: #fff;
}

.gold {
  {/*color: #d4a51a; */}
  background: linear-gradient(90deg, #b58a0a, #f5d76e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* TEXTO */

.hero p {
  font-size: clamp(0.9rem, 1.5vw, 1.15rem);
  line-height: 1.7;
  letter-spacing: 0.01em;
  max-width: 720px;
  margin-bottom: 42px;
  color: #fff;
  text-align: left;
  font-weight: 400;
}

/* BOTÕES */

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 40px;
}

.btn {
  padding: 10px 20px;
  border-radius: 10px;
  text-decoration: none;
  font-size: clamp(0.85rem, 1.2vw, 0.90rem);
  font-weight: 500;
}

{/*.primary {
  background: #b58a0a;
  color: #000;
}
 */}

.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(181,138,10,0.25);
}

.secondary {
  border: 1px solid #b58a0a;
  color: #f5d76e;
}

.secondary:hover {
  background: rgba(181,138,10,0.08);
}

/* STATS */

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  max-width: 760px;
  margin: 0;
  padding: 0;
}

.stats dt strong {
  display: block;
  margin-bottom: 1px;
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  font-weight: 600;
  color: #b58a0a;
}

.stats dd {
  margin-top: 10px;
  font-size: 10px;
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #fff;
}

/* RESPONSIVO */

@media (max-width: 768px) {

  .hero {
    min-height: 100svh;
    padding-bottom: 60px;
  }

  .bg img {
    object-position: 60% top;
  }

  .topbar .wrapper {
    justify-content: flex-start;
  }

  nav {
    display: none;
  }

  .container {
    padding: 130px 20px 80px;
  }

  .content {
    margin: 0 auto;
    padding-top: 10px;
  }

  .hero h1 {
    line-height: 1.1;
    font-size: 1.8rem;
  }

  .hero p {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 30px;
    line-height: 1.4;
    max-width: 100%;
  }

  .buttons {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 18px;
    max-width: 100%;
    margin-top: 5px;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stats dt strong {
    margin-bottom: 4px;
    line-height: 1;
  }

  .stats dd {
    margin-top: 5px;
    display: block;
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

}
</style>