---
import { Image, getImage } from 'astro:assets';

import imgDesktop from '../assets/divisorias-de-vidros-com-persianas-1920px.webp';
import imgMobile from '../assets/divisorias-de-vidros-com-persianas-768x1080.webp';

const mobileOptimized = await getImage({
  src: imgMobile,
  width: 768,
  quality: 45,
  format: 'webp'
});
---

<section class="hero">

  <!-- BACKGROUND -->
  <div class="bg">

    <picture>

      <!-- MOBILE -->
      <source
        media="(max-width: 767px)"
        srcset={mobileOptimized.src}
        type="image/webp"
      />

      <!-- DESKTOP -->
      <Image
        src={imgDesktop}
        alt="Divisórias de vidro com persianas embutidas instaladas em escritório"
        widths={[1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={45}
        format="webp"
        decoding="sync"
      />

    </picture>

    <div class="overlay"></div>

  </div>

  <!-- HEADER -->
  <header class="topbar">

    <div class="wrapper">

      <a href="#" class="logo" aria-label="Divisórias de Vidros com Persianas - página inicial">
        <img
          src="/divisorias-vidros-persianas-logo.png"
          alt="Divisórias de Vidro com Persianas"
          width="91"
          height="44"
          loading="eager"
          fetchpriority="low"
          decoding="async"
        />
      </a>

      <!-- CHECKBOX -->
      <input type="checkbox" id="menu-toggle" />

      <!-- BOTÃO -->
      <label for="menu-toggle" class="menu-icon" aria-label="Abrir menu">
        <span class="hamburger"></span>
      </label>

      <!-- MENU -->
      <nav class="nav" aria-label="Menu principal">
        <a href="#modelos">Modelos</a>
        <a href="#diferenciais">Diferenciais</a>
        <a href="#processo">Processo</a>
        <a href="#orcamento">Orçamento</a>
      </nav>

    </div>

  </header>

  <!-- CONTEÚDO -->
  <div class="container">

    <div class="content">

      <h1>
        O ambiente que <span class="gold">impressiona</span><br />
        clientes, investidores e parceiros de negócios,
        sem precisar dizer uma <span class="gold">palavra</span>.
      </h1>

      <p>
        Divisória em vidro duplo com persiana embutida, aumenta o valor da sua marca, com
        <b>competência e profissionalismo</b> — através de conforto, estilo e sofisticação.
      </p>

      <div class="buttons" role="group" aria-label="Ações principais">
        <a href="#modelos" class="btn secondary">
          VER MODELOS
        </a>
      </div>

      <dl class="stats">

        <div>
          <dt>+21</dt>
          <dd>anos no mercado</dd>
        </div>

        <div>
          <dt>+800</dt>
          <dd>projetos entregues</dd>
        </div>

        <div>
          <dt>100%</dt>
          <dd>fabricação própria</dd>
        </div>

        <div>
          <dt>Pagamento</dt>
          <dd>com cartão BNDES</dd>
        </div>

      </dl>

    </div>

  </div>
  const menuToggle = document.getElementById('menu-toggle');
  const menuLinks = document.querySelectorAll('.nav a');

  menuLinks.forEach(link => {
    link.addEventListener('click', () => {
      menuToggle.checked = false;
    });
  });
</script>
</section>

<style>
.hero {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.bg picture {
  width: 100%;
  height: 100%;
  display: block;
  position: relative;
  z-index: 0;
}

.bg img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  position: relative;
  z-index: 0;
}

.overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(0,0,0,0.55);
}

.wrapper {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.topbar .wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 20px;
}

/* LOGO */
.logo {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.logo img {
  width: 91px;
  height: auto;
  display: block;
}

/* CHECKBOX */
#menu-toggle {
  display: none;
}

/* MENU */
.nav {
  display: flex;
  gap: 28px;
}

.nav a {
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  transition: opacity 0.3s ease;
}

.nav a:hover {
  color: #b58a0a;
  opacity: 0.85;
}

/* BOTÃO MENU */
.menu-icon {
  display: none;
  width: 32px;
  height: 32px;
  position: relative;
  cursor: pointer;
  z-index: 30;
  -webkit-tap-highlight-color: transparent;
}

/* LINHAS */
.hamburger,
.hamburger::before,
.hamburger::after {
  content: '';
  position: absolute;
  width: 28px;
  height: 2px;
  background: #fff;
  border-radius: 999px;
  transition:
    transform 0.25s ease,
    opacity 0.2s ease;
}

.hamburger {
  top: 50%;
  left: 2px;
  transform: translateY(-50%);
}

.hamburger::before {
  top: -8px;
}

.hamburger::after {
  top: 8px;
}

/* TRANSFORMA EM X */
#menu-toggle:checked + .menu-icon .hamburger {
  background: transparent;
}

#menu-toggle:checked + .menu-icon .hamburger::before {
  transform: translateY(8px) rotate(45deg);
}

#menu-toggle:checked + .menu-icon .hamburger::after {
  transform: translateY(-8px) rotate(-45deg);
}

.container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 140px 20px 80px;
}

.content {
  max-width: 720px;
  padding-top: 50px;
}

.hero h1 {
  font-size: 2.4rem;
  line-height: 1.05;
  font-weight: 500;
  margin-bottom: 28px;
  text-align: left;
  color: #fff;
}

.gold {
  color: #b58a0a;
}

.hero p {
  font-size: clamp(0.9rem, 1.5vw, 1.15rem);
  line-height: 1.7;
  letter-spacing: 0.01em;
  max-width: 720px;
  margin-bottom: 42px;
  color: #fff;
  text-align: left;
  font-weight: 400;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 40px;
}

.btn {
  padding: 10px 20px;
  border-radius: 10px;
  text-decoration: none;
  font-size: clamp(0.85rem, 1.2vw, 0.90rem);
  font-weight: 500;
  will-change: transform;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.secondary {
  border: 1px solid #b58a0a;
  color: #f5d76e;
}

.secondary:hover {
  background: rgba(181,138,10,0.08);
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  max-width: 760px;
  margin: 0;
  padding: 0;
}

.stats dt {
  display: block;
  margin-bottom: 1px;
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  font-weight: 200;
  color: #b58a0a;
}

.stats dd {
  margin-top: 10px;
  font-size: 10px;
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #fff;
}

@media (max-width: 768px) {

  .hero {
    min-height: 100svh;
    padding-bottom: 60px;
  }

  .bg img {
    object-position: 60% top;
  }

  .topbar .wrapper {
    justify-content: space-between;
  }

  /* BOTÃO APARECE */
  .menu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* MENU MOBILE */
  .nav {
   position: fixed;
   inset: 0;

   width: 100%;
   height: 100svh;

   background: rgba(0,0,0,0.98);
   backdrop-filter: blur(12px);

   padding:
    120px
    32px
    40px;

   display: flex;
   flex-direction: column;
   align-items: flex-start;
   justify-content: flex-start;

   gap: 26px;

   opacity: 0;
   visibility: hidden;
   pointer-events: none;

   transform: translateY(-10px);

   transition:
    opacity 0.25s ease,
    transform 0.25s ease,
    visibility 0.25s;

   z-index: 20;
}

  /* MENU ABERTO */
  #menu-toggle:checked + .menu-icon + .nav {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav a {
   font-size: 1.3rem;
   font-weight: 500;
   text-align: left;
 }

  .container {
    padding: 130px 20px 80px;
  }

  .content {
    margin: 0 auto;
    padding-top: 10px;
  }

  .hero h1 {
    line-height: 1.1;
    font-size: 1.8rem;
  }

  .hero p {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 30px;
    line-height: 1.4;
    max-width: 100%;
  }

  .buttons {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 18px;
    max-width: 100%;
    margin-top: 5px;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stats dt {
    margin-bottom: 4px;
    line-height: 1;
  }

  .stats dd {
    margin-top: 5px;
    display: block;
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

}
</style>