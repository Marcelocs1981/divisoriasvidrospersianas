---
import { Image, getImage } from 'astro:assets';

import imgDesktop from '../assets/divisorias-de-vidros-com-persianas-1920px.webp';
import imgMobile from '../assets/divisorias-de-vidros-com-persianas-768x1080.webp';

/* IMAGEM MOBILE OTIMIZADA */
const mobileOptimized = await getImage({
  src: imgMobile,
  width: 768,
  quality: 45,
  format: 'webp'
});
---

<section class="hero">

  <!-- BACKGROUND -->
  <div class="bg">

    <picture>

  <!-- MOBILE -->
  <source
    media="(max-width: 767px)"
    srcset={mobileOptimized.src}
  />

  <!-- DESKTOP -->
  <source
    media="(min-width: 768px)"
    srcset={imgDesktop.src}
  />

  <img
    src={imgDesktop.src}
    alt="Divisórias de vidro com persianas embutidas instaladas em escritório"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    width="1920"
    height="1080"
  />

</picture>

    <div class="overlay"></div>
    <div class="gold-glow"></div>

  </div>

  <!-- TOPBAR -->
  <div class="topbar">

    <div class="wrapper">

      <div class="logo">

        <div class="logo-box">
          DVP
        </div>

        <div class="logo-text">
          Divisórias de Vidros com Persianas<span>.</span>
        </div>

      </div>

      <nav>
        <a href="#modelos">Modelos</a>
        <a href="#diferenciais">Diferenciais</a>
        <a href="#processo">Processo</a>
        <a href="#orcamento">Orçamento</a>
      </nav>

    </div>

  </div>

  <!-- CONTEÚDO -->
  <div class="container">

    <div class="content">

      <h1>
        Divisórias de Vidros com Persianas.
      </h1>

      <p>
        Divisória em vidro duplo com persiana embutida, aumenta o valor da sua marca, com
        <b>competência e profissionalismo</b> — através de conforto, estilo e sofisticação.
      </p>

      <div class="buttons">

        <a href="#orcamento" class="btn primary">
          Solicitar Projeto Exclusivo Sob Medida
        </a>

        <a href="#modelos" class="btn secondary">
          Ver Todos os Modelos
        </a>

      </div>

      <div class="stats">

        <div>
          <strong>+21</strong>
          <span>anos no mercado</span>
        </div>

        <div>
          <strong>+800</strong>
          <span>projetos entregues</span>
        </div>

        <div>
          <strong>100%</strong>
          <span>fabricação própria</span>
        </div>

        <div>
          <strong>Pagamento</strong>
          <span>com cartão BNDES</span>
        </div>

      </div>

    </div>

  </div>

</section>

<style>
.hero {
  position: relative;
  width: 100%;
  min-height: 700px;
  display: flex;
  align-items: center;
  overflow: clip;
  color: #fff;
  background: #050505;
}

/* BACKGROUND */

.bg {
  position: relative;
  width: 100%;
  height: 100%;
}

.bg picture {
  width: 100%;
  height: 100%;
  display: block;
}

.bg img {
  width: 100%;
  height: auto;
}

/* OVERLAY */

.overlay {
  background: rgba(0,0,0,0.55);
}

.gold-glow {
 display: none;
}

/* LAYOUT */

.wrapper {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

/* TOPBAR */

.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.topbar .wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 20px;
}

/* LOGO */

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-box {
  width: 42px;
  height: 42px;
  background: #b58a0a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #000;
  font-weight: 200;
  flex-shrink: 0;
}

.logo-text {
  font-size: clamp(0.7rem, 1.5vw, 1.15rem);
  font-family: 'Inter', sans-serif;
}

.logo-text span {
  color: #b58a0a;
}

/* MENU */

nav {
  display: flex;
  gap: 28px;
}

nav a {
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  transition:
    color 0.3s ease,
    opacity 0.3s ease;
  will-change: opacity;
}

nav a:hover {
  color: #b58a0a;
}

/* CONTEÚDO */
.container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 140px 20px 80px;
}

.content {
  max-width: 720px;
  padding-top: 50px;
}

/* TÍTULO */
.hero h1 {
  font-size: clamp(1.6rem, 2vw, 3.4rem);
  line-height: 1.15;
  font-weight: 500;
  margin-bottom: 20px;
  letter-spacing: 0;
  font-family: serif;
  text-align: left;
  max-width: 12ch;
}

.gold {
  color: #d4a51a;
}

/* TEXTO */
.hero p {
  font-size: clamp(0.9rem, 1.5vw, 1.15rem);
  line-height: 1.7;
  letter-spacing: 0.01em;
  max-width: 720px;
  margin-bottom: 42px;
  color: rgba(255,255,255,0.92);
  text-align: left;
  font-weight: 300;
}

/* BOTÕES */
.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 40px;
}

.btn {
  padding: 10px 20px;
  border-radius: 10px;
  text-decoration: none;
  font-size: clamp(0.85rem, 1.2vw, 1rem);
  font-weight: 700;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
  will-change: transform;
}

.primary {
  background: #b58a0a;
  color: #000;
}

.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(181,138,10,0.25);
}

.secondary {
  border: 1px solid #b58a0a;
  color: #f5d76e;
}

.secondary:hover {
  background: rgba(181,138,10,0.08);
}

/* STATS */
.stats {
  display: none;
}

.stats strong {
  display: block;
  margin-bottom: 1px;
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  color: #b58a0a;
}

.stats span {
  font-size: 10px;
  line-height: 1.1;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #fff;
}

/* RESPONSIVO */
@media (max-width: 768px) {

  .hero {
    min-height: auto;
    padding-bottom: 60px;
  }

  .bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

  .topbar .wrapper {
    justify-content: flex-start;
  }

  nav {
    display: none;
  }

  .container {
    padding: 130px 20px 80px;
  }

  .content {
    margin: 0 auto;
    padding-top: 10px;
  }

  .hero h1 {
    line-height: 1.1;
    text-wrap: pretty;
  }

  .hero p {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 30px;
    line-height: 1.4;
    max-width: 100%;
  }

  .buttons {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 18px;
    max-width: 100%;
    margin-top: 5px;
  }

  .stats div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stats strong {
    margin-bottom: 4px;
    line-height: 1;
  }

  .stats span {
    display: block;
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #fff;
  }

}
</style>