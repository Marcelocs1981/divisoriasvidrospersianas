---
import "../styles/fonts.css";
import { Image } from 'astro:assets';

// Importando as duas versões da imagem
import imgDesktop from '../assets/divisorias-de-vidros-com-persianas-1920px.webp';
import imgMobile from '../assets/divisorias-de-vidros-com-persianas-650px.webp';
---

<section class="hero">
  <div class="bg">
    <picture>
  <source 
    media="(max-width: 767px)" 
    srcset={imgMobile.src} 
  />
  <Image 
    src={imgDesktop}
    alt="Divisórias de vidro com persianas embutidas instaladas em escritório"
    widths={[650, 1024, 1920]}
    sizes="(max-width: 767px) 650px, 100vw"
    loading="eager"
    fetchpriority="high"
    quality={60} 
    format="webp"
  />
</picture>

    <div class="overlay"></div>
    <div class="gold-glow"></div>
  </div>

  <div class="topbar">
    <div class="wrapper">
      <div class="logo">
        <div class="logo-box">DVP</div>
        <div class="logo-text">Divisórias de Vidros com Persianas<span>.</span></div>
      </div>
      <nav>
        <a href="#modelos">Modelos</a>
        <a href="#diferenciais">Diferenciais</a>
        <a href="#processo">Processo</a>
        <a href="#orcamento">Orçamento</a>
      </nav>
    </div>
  </div>

  <div class="container">
    <div class="content">
      <h1>
        O ambiente que <span class="gold">impressiona</span><br />
        clientes, investidores e parceiros de negócios, antes da primeira <span class="gold">palavra</span>.
      </h1>
      <p>
        Divisórias de vidro com persianas embutidas que transformam seu escritório em uma
        <strong>declaração de autoridade</strong> — com conforto acústico, térmico e visual.
      </p>

      <div class="buttons">
        <a href="#orcamento" class="btn primary">Solicitar Projeto Exclusivo →</a>
        <a href="#modelos" class="btn secondary">Ver os 11 modelos</a>
      </div>

      <div class="stats">
        <div>
          <strong>+25</strong>
          <span>anos no mercado</span>
        </div>
        <div>
          <strong>+800</strong>
          <span>projetos entregues</span>
        </div>
        <div>
          <strong>100%</strong>
          <span>fabricação própria</span>
        </div>
        <div>
          <strong>Pagamento</strong>
          <span>com cartão BNDES</span>
        </div>
      </div>
    </div>
  </div>

  <div class="scroll">role para descobrir</div>
</section>

<style>
/* Reset local para evitar saltos de layout */
.hero {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: #fff;
  background: #050505; /* Fallback de cor */
}

/* BACKGROUND */
.bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* Transform removido para evitar avisos de performance do Lighthouse em telas menores */
}

.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0,0,0,0.9) 0%,
    rgba(0,0,0,0.65) 45%,
    rgba(0,0,0,0.2) 100%
  );
}

.gold-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 70% 30%, rgba(150,112,0,0.2), transparent 50%);
}

.wrapper, .container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

/* TOPBAR */
.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.topbar .wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 0;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-box {
  width: 40px;
  height: 40px;
  background: #b58a0a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: #000;
}

.logo-text {
  font-size: 18px;
  font-family: 'Inter', sans-serif;
}

.logo-text span {
  color: #b58a0a;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  color: #ccc;
  text-decoration: none;
  font-size: 14px;
  transition: 0.3s;
}

nav a:hover {
  color: #b58a0a;
}

/* CONTEÚDO */
.container {
  position: relative;
  z-index: 2;
  padding: 100px 0 80px;
}

.content {
  max-width: 800px;
}

.hero h1 {
  font-size: 3.5rem;
  line-height: 1.1;
  font-weight: 400; /* Ajustado para Cormorant Regular */
  margin-bottom: 30px;
  letter-spacing: -1px;
  font-family: 'Cormorant', serif;
}

.gold {
  background: linear-gradient(90deg, #b58a0a, #f5d76e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 700;
}

.hero p {
  font-size: 1.1rem;
  color: #ddd; /* Melhor contraste para acessibilidade */
  max-width: 650px;
  margin-bottom: 40px;
  line-height: 1.6;
}

.buttons {
  display: flex;
  gap: 15px;
  margin-bottom: 60px;
}

.btn {
  padding: 16px 28px;
  border-radius: 8px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: 0.3s;
}

.primary {
  background: #b58a0a;
  color: #000;
}

.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(181, 138, 10, 0.2);
}

.secondary {
  border: 1px solid #b58a0a;
  color: #b58a0a;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  max-width: 700px;
}

.stats strong {
  display: block;
  font-size: 24px;
  color: #b58a0a;
}

.stats span {
  font-size: 10px;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.scroll {
  position: absolute;
  bottom: 30px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 10px;
  letter-spacing: 4px;
  color: #777;
  text-transform: uppercase;
}

/* RESPONSIVO */
@media (max-width: 768px) {
  .hero {
    text-align: center;
    align-items: flex-start;
    padding-top: 120px;
  }

  .hero h1 {
    font-size: 2.2rem;
  }

  nav {
    display: none;
  }

  .content {
    margin: 0 auto;
  }

  .buttons {
    flex-direction: column;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
    margin: 0 auto;
  }
}
</style>