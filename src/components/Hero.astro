---
import "../styles/fonts.css";
import { Image } from 'astro:assets';
import imgDesktop from '../assets/divisorias-de-vidros-com-persianas.webp';
---
<section class="hero">
  <!-- BACKGROUND -->
  <div class="bg">

    <Image 
      src={imgDesktop}
      alt="Divisórias de vidro com persianas"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      loading="eager"
      format="webp"
    />

    <div class="overlay"></div>
    <div class="gold-glow"></div>

  </div>
  <!-- TOP BAR -->
  <div class="topbar">
    <div class="wrapper">
      <div class="logo">
        <div class="logo-box">DVP</div>
        <div class="logo-text">Divisórias de Vidros com Persianas<span>.</span></div>
      </div>
      <nav>
        <a href="#modelos">Modelos</a>
        <a href="#diferenciais">Diferenciais</a>
        <a href="#processo">Processo</a>
        <a href="#orcamento">Orçamento</a>
      </nav>
    </div>
  </div>
  <!-- CONTEÚDO -->
  <div class="container">
    <div class="content">
     <!--div class="badge">
        <span class="dot"></span>
        Fabricação Própria · São Paulo · 25 anos
      </div>-->
      <h1>
        O ambiente que <span class="gold">impressiona</span><br />
        clientes, investidores e parceiros de negócios, antes da primeira <span class="gold">palavra</span>.
      </h1>
      <p>
        Divisórias de vidro com persianas embutidas que transformam seu escritório em uma
        <strong>declaração de autoridade</strong> — com conforto acústico, térmico e visual.
      </p>

      <div class="buttons">
        <a href="#orcamento" class="btn primary">Solicitar Projeto Exclusivo →</a>
        <a href="#modelos" class="btn secondary">Ver os 11 modelos</a>
      </div>

      <div class="stats">
        <div>
          <strong>+25</strong>
          <span>anos no mercado</span>
        </div>
        <div>
          <strong>+800</strong>
          <span>projetos entregues</span>
        </div>
        <div>
          <strong>100%</strong>
          <span>fabricação própria</span>
        </div>
        <div>
          <strong>Pagamento</strong>
          <span>com cartão BNDES</span>
        </div>
      </div>

    </div>
  </div>

  <!-- SCROLL -->
  <div class="scroll">role para descobrir</div>
</section>

<style>

/* RESET ESSENCIAL */
html, body {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #050505;
}

/* HERO */
.hero {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: #fff;
}

/* BACKGROUND */
.bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.05);
  will-change: transform;
}

/* overlay escuro */
.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0,0,0,0.9) 0%,
    rgba(0,0,0,0.65) 45%,
    rgba(0,0,0,0.2) 100%
  );
}

/* glow dourado */
.gold-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 70% 30%, rgba(150,112,0,0.25), transparent 50%);
}

/* PADRÃO GLOBAL */
.wrapper,
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

/* TOPBAR */
.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.topbar .wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 0;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo-box {
  width: 40px;
  height: 40px;
  background: #b58a0a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: #000;
}

.logo-text {
  font-size: 18px;
}

.logo-text span {
  color: #b58a0a;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  color: #ccc;
  text-decoration: none;
  font-size: 14px;
  transition: 0.3s;
}

nav a:hover {
  color: #b58a0a;
}

/* CONTAINER */
.container {
  position: relative;
  z-index: 2;
  padding: 100px 0 80px;
}

/* CONTENT */
.content {
  max-width: 800px;
}

/* BADGE */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  border-radius: 999px;
  border: 1px solid rgba(150,112,0,0.4);
  background: rgba(0,0,0,0.6);
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #b58a0a;
  margin-bottom: 30px;
}

.dot {
  width: 6px;
  height: 6px;
  background: #b58a0a;
  border-radius: 50%;
}

/* TÍTULO */
.hero h1 {
  font-size: 3.5rem;
  line-height: 1.05;
  font-weight: 200;
  margin-bottom: 30px;
  letter-spacing: -1px;
  font-family: 'Cormorant', serif;
}

/* TEXTO DOURADO */
.gold {
  background: linear-gradient(90deg, #b58a0a, #f5d76e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* TEXTO */
.hero p {
  font-size: 18px;
  color: #ccc;
  max-width: 650px;
  margin-bottom: 40px;
}

/* BOTÕES */
.buttons {
  display: flex;
  gap: 15px;
  margin-bottom: 60px;
}

.btn {
  padding: 14px 24px;
  border-radius: 8px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 400;
  transition: 0.3s;
  position: relative;
  overflow: hidden;
}

.primary {
  background: linear-gradient(135deg, #b58a0a, #b8962e);
  color: #000;
}

.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(150,112,0,0.3);
}

.secondary {
  border: 1px solid rgba(150,112,0,0.4);
  color: #b58a0a;
}

.secondary:hover {
  background: rgba(150,112,0,0.1);
}

/* STATS */
.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  max-width: 700px;
}

.stats strong {
  display: block;
  font-size: 28px;
  color: #b58a0a;
}

.stats span {
  font-size: 11px;
  color: #aaa;
  text-transform: uppercase;
}

/* SCROLL */
.scroll {
  position: absolute;
  bottom: 30px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 10px;
  letter-spacing: 4px;
  color: #aaa;
}

/* RESPONSIVO */
@media (max-width: 768px) {

  .hero h1 {
    font-size: 34px;
  }

  nav {
    display: none;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .buttons {
    flex-direction: column;
  }
}

</style>