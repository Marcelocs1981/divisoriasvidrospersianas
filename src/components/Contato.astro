---
/* Frontmatter limpo */
---

<section 
  id="contato" 
  class="section-padrao section-contato" 
  aria-labelledby="contato-heading"
>
  <div class="container content-grid-contato">

    <aside class="contato-info">
      <header>
        <span class="tag">Entre em contato com a imprimiprinter</span>
        <h2 id="contato-heading">
          Teremos o maior prazer <span class="goldgradient">em falar com você</span> e te ajudar.
        </h2>
      </header>

      <p class="contato-description">
        Em poucos minutos, entraremos em contato com você.
      </p>
      <p class="contato-description">
        Envie seus dados pelo formulário abaixo, para que possamos entrar em contato com você! Ou se preferir, ligue no telefone de atendimento <a href="tel:1148105912">(11) 4810-5912</a> ou envie um email para <a href="mailto:contato@divisoriasvidrospersianas.com.br">contato@divisoriasvidrospersianas.com.br</a>
      </p>

    </aside>

    <div class="form-card">
      <form
        class="contato-form"
        id="contato-form"
        method="POST"
        autocomplete="on"
      >
        <label for="nome">
          <span>Nome*</span>
          <input type="text" id="nome" name="nome" autocomplete="name" required />
        </label>

        <label for="empresa">
          <span>Empresa</span>
          <input type="text" id="empresa" name="empresa" autocomplete="organization" />
        </label>

        <label for="email">
          <span>E-mail*</span>
          <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required />
        </label>

        <label for="telefone">
          <span>Telefone*</span>
          <input type="tel" id="telefone" name="telefone" autocomplete="tel" inputmode="tel" required />
        </label>

        <label for="mensagem" class="label-textarea">
          <span>Conte sobre seu projeto</span>
          <textarea
            id="mensagem"
            name="mensagem"
            rows="5"
            placeholder="Metragem aproximada, localização, prazo desejado..."
          ></textarea>
        </label>

        <button type="submit" aria-label="Solicitar orçamento personalizado">
          SOLICITAR ORÇAMENTO
        </button>

        <output id="status-message" class="status-message" aria-live="polite"></output>

        <small class="privacy-notice">
          ⚠️ Ao enviar, você concorda com nossa política de privacidade.
        </small>
      </form>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contato-form') as HTMLFormElement;
  const statusMessage = document.getElementById('status-message');

  if (form && statusMessage) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button');
      if (!button) return;

      form.setAttribute('aria-busy', 'true');
      button.disabled = true;
      button.textContent = 'ENVIANDO...';
      statusMessage.textContent = '';
      statusMessage.classList.remove('success', 'error');

      try {
        const formData = new FormData(form);
        const response = await fetch('/send.php', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (result.success) {
          statusMessage.textContent = 'Mensagem enviada com sucesso!';
          statusMessage.classList.add('success');
          form.reset();
        } else {
          statusMessage.textContent = 'Erro ao enviar mensagem.';
          statusMessage.classList.add('error');
        }
      } catch {
        statusMessage.textContent = 'Erro ao enviar mensagem.';
        statusMessage.classList.add('error');
      } finally {
        form.setAttribute('aria-busy', 'false');
        button.disabled = false;
        button.textContent = 'SOLICITAR ORÇAMENTO';
      }
    });
  }
</script>

<style>
  /* GRADIENTE DE FUNDO UNIFICADO NA SEÇÃO */
  .section-contato {
    position: relative;
  }

  .section-contato::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 20%, rgba(124, 93, 0, 0.25), transparent 50%);
    pointer-events: none;
  }

  /* GRID DE CONTROLE SEGURO NO DESKTOP */
  .content-grid-contato {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 60px;
    align-items: center;
  }

  /* BLOCO ESQUERDO: INFORMAÇÕES */
  .contato-info h2 {
    margin-bottom: 28px;
  }

  .contato-description {
    margin-bottom: 22px;
  }

  /* LISTAGEM DE BENEFÍCIOS OTIMIZADA */
  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 40px 0 0 0;
  }

  .benefits-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
    color: #c7c7c7;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    line-height: 1.5;
  }

  .check-icon {
    color: #967000;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* BLOCO DIREITO: FORM CARD VISUAL */
  .form-card {
    background: rgba(20, 20, 20, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 30px;
    backdrop-filter: blur(8px);
  }

  /* ESTRUTURA DO FORMULÁRIO */
  .contato-form {
    display: grid;
    gap: 18px;
  }

  /* ESTRUTURA LABELS (Alinhamento Horizontal Limpo no PC) */
  .contato-form label {
    display: grid;
    grid-template-columns: 160px 1fr;
    align-items: center;
    gap: 14px;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .contato-form .label-textarea {
    align-items: start;
  }

  /* INPUTS E TEXTAREA CAMPOS */
  .contato-form input,
  .contato-form textarea {
    width: 100%;
    background: #050505;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: #fff;
    padding: 14px 16px;
    font-size: 0.95rem;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contato-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contato-form input::placeholder,
  .contato-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .contato-form input:focus,
  .contato-form textarea:focus {
    border-color: rgba(150, 112, 0, 0.7);
    box-shadow: 0 0 0 1px rgba(150, 112, 0, 0.25), 0 0 18px rgba(150, 112, 0, 0.08);
  }

  /* BOTÃO DA SESSÃO */
  .contato-form button {
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: 4px;
    background: linear-gradient(180deg, #c89d37, #967000);
    color: #000;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contato-form button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(150, 112, 0, 0.2);
  }

  .contato-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* FEEDBACKS */
  .status-message {
    min-height: 20px;
    text-align: center;
    font-size: 0.9rem;
  }

  .status-message.success { color: #7dffb3; }
  .status-message.error { color: #ff7d7d; }

  .privacy-notice {
    display: block;
    text-align: center;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  /* RESPONSIVIDADE EM DEGUSTAÇÃO MÁXIMA */
  @media (max-width: 1100px) {
    .content-grid-contato {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 768px) {
    .form-card {
      padding: 22px;
    }

    .contato-form label {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .contato-form textarea {
      resize: none;
    }
  }
</style>