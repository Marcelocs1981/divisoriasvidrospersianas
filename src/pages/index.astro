---
import { getImage } from 'astro:assets';
import imgDesktop from '../assets/divisorias-de-vidros-com-persianas-1920px.webp';
import imgMobile from '../assets/divisorias-de-vidros-com-persianas-768x1080.webp';
import Layout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Anticipation from '../components/Anticipation.astro';
import Diferenciais from '../components/Diferenciais.astro';
import Produtos from '../components/Produtos.astro';
import Escolher from '../components/Escolher.astro';
import Reuniao from '../components/Reuniao.astro';
import Primeiro from '../components/Primeiro.astro';
import Parceiros from '../components/Parceiros.astro';
import Orcamento from '../components/Orcamento.astro';

const lcpDesktop = await getImage({ src: imgDesktop, format: 'webp', quality: 45, width: 1920 });
const lcpMobile = await getImage({ src: imgMobile, format: 'webp', quality: 45, width: 768 });
---
<Layout
  seo={{
    title: "Divisórias de Vidro com Persianas",
    description: "Divisórias de vidros com persianas embutidas é aqui! Seja bem vindo ao nosso site. Descubra soluções elegantes e funcionais para ambientes corporativos, industriais e comerciais. Explore nossa variedade de produtos e encontre a divisória em vidro duplo com persiana integrada perfeita para transformar seu espaço corporativo.",
  }}
  lcpDesktopSrc={lcpDesktop.src}
  lcpMobileSrc={lcpMobile.src}
>
  <Header />
  <Hero />
  <Anticipation />
  <Diferenciais />
  <Produtos />
  <Escolher />
  <Reuniao />
  <Primeiro />
  <Parceiros />
  <Orcamento />
</Layout>