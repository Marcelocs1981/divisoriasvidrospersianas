      max-width: 800px;
      margin: 0 auto;
    }

    .privacy-content h2 {
      margin-bottom: 25px;
    }

    .privacy-content p {
      margin-bottom: 25px;
    }

    .intro-block {
      margin-bottom: 30px;
    }

    .privacy-toc {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 8px;
      padding: 24px 28px;
      margin: 40px 0;
      color: #eaeaea;
      line-height: 1.6;
    }

    @media (max-width: 767px) {
      .privacy-toc {
        padding: 20px 15px;
      }
      .privacy-toc a {
        font-size: 0.9rem;
